#config echo off
#config max_iterations 0

plugin oli_opengl
plugin oli_keyboard
plugin oli_math
plugin oli_time

# 1. Inițializare Fereastră
set $v = GL_INIT(900, 700, "OLI Shader Demo")

#set $res = GL_SET_VSYNC(1)

if $res == 1 then
    echo "VSync activat cu succes!"
else
    echo "Placa video nu suporta controlul VSync."
endif


set $currW = GL_WIDTH()
set $currH = GL_HEIGHT()


# 2. DEFINIRE TIMP START (FOARTE IMPORTANT!)
set $startTime = TIME()

# 3. Shadere (Scrise compact pentru a evita problemele de concatenare ale parserului)

# Citim conținutul fișierelor
set $vs_source = readfile("examples/shaders/vertex.glsl")
set $fs_source = readfile("examples/shaders/fragment.glsl")

# Verificăm dacă fișierele au fost găsite
if $vs_source == null || $fs_source == null then
    GL_CLOSE()
    exit("Eroare: Nu am putut incarca fisierele shader!")
endif

# Încărcăm shaderele în OpenGL
set $vshader = GL_LOAD_SHADER(0, $vs_source)
set $fshader = GL_LOAD_SHADER(1, $fs_source)

if $fshader == 0 then
	
	GL_CLOSE()
    exit( "EROARE COMPILARE: " + GL_GET_ERROR() )
    # Putem chiar să afișăm eroarea pe ecranul OpenGL dacă vrem
endif


# 4. Compilare și Linkare
set $prog = GL_LINK_PROGRAM($vshader, $fshader)

echo "Shadere incarcate. Program ID: " + STR($prog)


set $startTime = TIME()
set $lastTime = TIME()
set $fpsUpdateTimer = 0
set $fpsText = "Calculare..."

# Variabile pentru statistici
set $minFps = 99999.0
set $maxFps = 0.0
set $avgFps = 0.0
set $frameCounter = 0
set $totalFpsSum = 0.0

# 5. Loop principal
set $c = 1
while true do
	
	set $currX = GL_MOUSE_X()
    set $currY = GL_MOUSE_Y()
    set $isDown = GL_MOUSE_BTN(0)

    # Dacă butonul e apăsat, actualizăm și punctul de click (zw)
    if $isDown == 1 then
        set $clickX = $currX
        set $clickY = $currY
    endif


	# 1. Calculăm DeltaTime
    set $currentTime = TIME()
    set $dt = $currentTime - $lastTime
    set $lastTime = $currentTime
    
    if $dt > 0 then
        set $currentFps = 1.0 / $dt
        
        # 2. Actualizăm Min și Max (după ce s-a stabilizat motorul, ex: după 1 secunda)
        if $currentTime - $startTime > 1.0 then
            if $currentFps < $minFps then set $minFps = $currentFps endif
            if $currentFps > $maxFps then set $maxFps = $currentFps endif
            
            # Pentru medie
            set $frameCounter = $frameCounter + 1
            set $totalFpsSum = $totalFpsSum + $currentFps
            #set $avgFps = $totalFpsSum / $frameCounter
			set $avgFps = ($avgFps * 0.9) + ($currentFps * 0.1)
        endif
    endif
	# 3. Update Text la fiecare 0.5 secunde
    set $fpsUpdateTimer = $fpsUpdateTimer + $dt
    if $fpsUpdateTimer > 0.5 then
        set $fpsText = "FPS: " + STR(ROUND($currentFps))
        set $statText = "MIN: " + STR(ROUND($minFps)) + " | MAX: " + STR(ROUND($maxFps)) + " | AVG: " + STR(ROUND($avgFps))
        set $fpsUpdateTimer = 0
    endif

    # Nu e nevoie de GL_CLEAR la fullscreen, dar e bine pentru test
    GL_CLEAR(0x000000)
    
    GL_USE_PROGRAM($prog)
	
    set $currW = GL_WIDTH()
	set $currH = GL_HEIGHT()
	
	
    # Calculăm timpul de la pornirea scriptului (valori mici: 0.1, 0.2...)
    set $localTime = TIME() - $startTime
    GL_SET_UNIFORM($prog, "iTime", $localTime)
	GL_SET_UNIFORM($prog, "iResolution", $currW , $currH)
	GL_SET_UNIFORM($prog, "iMouse", $currX, $currY, $clickX, $clickY)

    GL_DRAW_FULLSCREEN()
	GL_USE_PROGRAM(0)
	GL_TEXT(10, 25, $fpsText)
	GL_TEXT(10, 45, $statText)
	
    GL_PRESENT()

    if KEY_STATE(27) == 1 then 
		#set $c = 0
		break
	endif
endwhile

GL_CLOSE()
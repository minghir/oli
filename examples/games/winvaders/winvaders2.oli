# --- CONFIGURARE MOTOR ---
config echo off
config max_iterations 0

# --- SETUP PLUGINS ---
plugin oli_opengl
plugin oli_keyboard
plugin oli_math

# --- DEFINIȚII CLASE ---
# Păstrăm structura de date, dar mutăm logica în funcții globale 
# pentru a evita eroarea "Metoda nu a putut fi rezolvată"

def class Bullet { x, y, active, speed }
def class Enemy  { x, y, alive }
def class Player { x, y, size }

# --- INIȚIALIZARE SISTEM ---
set $SW = 800
set $SH = 600
set $v = GL_INIT($SW, $SH, "Oli Invaders 3D - Fixed")

# 1. Jucător
set $p = new("Player")
$p.x = 0
$p.y = -220
$p.size = 40

# 2. Inamici
set $numEnemies = 8
set $enemies = array($numEnemies)
for $i = 0 to $numEnemies - 1 do
    set $e = new("Enemy")
    $e.x = ($i * 80) - 280
    $e.y = 180
    $e.alive = 1
    set $enemies[$i] = $e
endfor

# 3. Gloanțe
set $maxBullets = 5
set $bullets = array($maxBullets)
for $i = 0 to $maxBullets - 1 do
    set $b = new("Bullet")
    $b.active = 0
    $b.speed = 15
    set $bullets[$i] = $b
endfor

# --- VARIABILE DE CONTROL ---
set $eDir = 1
set $eStep = 3

# --- LOOP PRINCIPAL ---
while true do
    # 1. Curățăm ecranul (Verifică dacă GL_CLEAR primește hex-ul corect în C++)
    GL_CLEAR(0x101025) 

    # 2. LOGICĂ ȘI DESENARE JUCĂTOR
    if KEY_STATE(37) == 1 then set $p.x = $p.x - 8 endif # Stânga
    if KEY_STATE(39) == 1 then set $p.x = $p.x + 8 endif # Dreapta
    
    # Desenăm jucătorul (Punct Verde mare)
    GL_POINT($p.x, $p.y, $p.size, 0x00FF00)

    # 3. LOGICĂ TRAGERE (Space)
    if KEY_STATE(32) == 1 then
        for $i = 0 to $maxBullets - 1 do
            if $bullets[$i].active == 0 then
                set $bullets[$i].active = 1
                set $bullets[$i].x = $p.x
                set $bullets[$i].y = $p.y + 20
                break 
            endif
        endfor
    endif

    # 4. UPDATE ȘI DESENARE GLOANȚE
    for $i = 0 to $maxBullets - 1 do
        if $bullets[$i].active == 1 then
            # Modificăm direct proprietatea y (evităm apelul de metodă problematic)
            set $bullets[$i].y = $bullets[$i].y + $bullets[$i].speed
            
            # Desenăm glonțul (Punct galben)
            GL_POINT($bullets[$i].x, $bullets[$i].y, 10, 0xFFFF00)
            
            # Dezactivăm dacă iese din ecran
            if $bullets[$i].y > 300 then set $bullets[$i].active = 0 endif
        endif
    endfor

    # 5. UPDATE ȘI DESENARE INAMICI
    set $edgeReached = 0
    for $i = 0 to $numEnemies - 1 do
        # Folosim referința directă din array
        if $enemies[$i].alive == 1 then
            # Mișcare
            set $enemies[$i].x = $enemies[$i].x + ($eStep * $eDir)
            
            # Verificăm marginea
            if $enemies[$i].x > 360 || $enemies[$i].x < -360 then 
                set $edgeReached = 1 
            endif
            
            # Desenăm Inamicul (Punct Roșu)
            GL_POINT($enemies[$i].x, $enemies[$i].y, 45, 0xFF0000)

            # 6. COLIZIUNI (Glonț vs Inamic)
            for $j = 0 to $maxBullets - 1 do
                if $bullets[$j].active == 1 then
                    set $distX = ABS($bullets[$j].x - $enemies[$i].x)
                    set $distY = ABS($bullets[$j].y - $enemies[$i].y)
                    
                    if $distX < 30 then
                        if $distY < 30 then
                            set $enemies[$i].alive = 0
                            set $bullets[$j].active = 0
                        endif
                    endif
                endif
            endfor
        endif
    endfor

    # 7. LOGICĂ COBORÂRE INAMICI
    if $edgeReached == 1 then
        set $eDir = $eDir * -1
        for $k = 0 to $numEnemies - 1 do
            set $enemies[$k].y = $enemies[$k].y - 30
        endfor
    endif

    # 8. AFIȘARE CADRU ȘI IEȘIRE
    GL_PRESENT()
    
    if KEY_STATE(27) == 1 then break endif
endwhile

GL_
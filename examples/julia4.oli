# --- OPTIMIZARE ---
config echo off
config max_iterations 0

# --- SETUP ---
plugin oli_canvas
plugin oli_math
plugin oli_keyboard
plugin oli_fract
plugin oli_time

set $v = CAN_INIT(640, 480, "Oli Modular Engine")
set $ptr = CAN_GET_PTR()
set $w = CAN_GET_WIDTH()
set $h = CAN_GET_HEIGHT()

while true do
    set $cX = 0.7 * COS(TIME() * 30)
    set $cY = 0.27 * SIN(TIME() * 15)

    # Plugin-ul de fractali scrie direct în memoria canvas-ului
    #set $v = FRACT_JULIA($ptr, $w, $h, $cX, $cY, 32)
	set $v = FRACT_PLASMA($ptr, $w, $h, $cX, $cY, 32)
    
    set $v = CAN_PRESENT()
    set $state = KEY_STATE(81)
    if $state > 0.5 then break; endif
endwhile

CAN_CLOSE()
echo "Fereastra a fost inchisa. Revenire in consola Oli."
config max_iterations 0
config echo off

plugin oli_opengl
plugin oli_keyboard
plugin oli_math

set $v = GL_INIT(900, 700, "Oli Engine - Quantum Pulse Rings")

# 🔥 Păcălim parserul să salveze valoarea ca DOUBLE (evităm optimizarea la Integer 0)
set $t = 0.01 
set $running = 1

while $running == 1 do
    set $v = GL_CLEAR(0xFF0000)

    set $t = $t + 0.04

    # --- CERCURI PULSANTE ---
    set $i = 0
    while $i < 6 do
        set $r = 40 + $i * 35 + 10 * SIN($t * 2 + $i)
        set $col = 0x2200FF + ($i * 0x002200)

        set $v = GL_CIRCLE(450, 350, $r, $col)
        set $i = $i + 1
    endwhile

    # --- CERC CENTRAL PLIN ---
    set $pulse = 30 + 10 * SIN($t * 5)
    # 🔥 Adăugat prefixul 'set $v =' pentru a intra pe ramura corectă de compilare
    set $v = GL_FILL_CIRCLE(450, 350, $pulse, 0xFF5500) 

    # --- PARTICULE ORBITALE ---
    set $k = 0
    while $k < 40 do
        set $ang = $k * 0.157 + $t * 1.5
        set $rr = 150 + 20 * SIN($t + $k)

        set $px = 450 + $rr * COS($ang)
        set $py = 350 + $rr * SIN($ang)

        set $v = GL_POINT($px, $py, 6, 0xFFFF00)

        set $k = $k + 1
    endwhile

    set $v = GL_PRESENT()

    if KEY_STATE(27) == 1 then
        set $running = 0
    endif
endwhile

set $v = GL_CLOSE()
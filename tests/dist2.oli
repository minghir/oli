# --- 1. PREGĂTIRE MEDIU ---
unset all; cls
plugin oli_plugin.dll

# --- 2. DEFINIRE BLUEPRINTS (Modelele de Date) ---
def struct Pozitie {x, y}
def struct Entitate {nume, poz}

# --- 3. DEFINIRE FUNCȚII ---

# Funcția A: Calculează distanța (Pitagora)
func CALCULEAZA_DISTANTA punct
    set $x = $punct.x
    set $y = $punct.y
    set $x2 = $x * $x
    set $y2 = $y * $y
    return SQRT($x2 + $y2)
endfunc

# Funcția B: Mișcare Globală (Side Effect prin @$)
# Modifică variabila globală al cărei nume este trimis ca string
func MOVE_GLOBAL nume_var dx dy
    echo "Sistem: Se mișcă entitatea '" + $nume_var + "'..."
    
    # Citim valorile actuale, adunăm deplasarea și scriem înapoi în Global
    set @$$nume_var.poz.x = @$$nume_var.poz.x + $dx
    set @$$nume_var.poz.y = @$$nume_var.poz.y + $dy
endfunc

# --- 4. EXECUTARE TEST ---

# Creăm Dragonul (Observă structura imbricată)
set $boss = Entitate("Dragon", Pozitie(100, 100))

echo "--- STARE INIȚIALĂ ---"
echo "Nume: " + $boss.nume
echo "Poziție: [" + $boss.poz.x + "," + $boss.poz.y + "]"
set $dist_initiala = CALCULEAZA_DISTANTA($boss.poz)
echo "Distanța față de origine: " + $dist_initiala

echo ""
# Mutăm Dragonul folosind indirectarea globală
# Îi dăm numele variabilei ("boss") nu valoarea ei ($boss)
MOVE_GLOBAL("boss", 50, -20)

echo ""
echo "--- STARE FINALĂ ---"
echo "Poziție Nouă: [" + $boss.poz.x + "," + $boss.poz.y + "]"
set $dist_finala = CALCULEAZA_DISTANTA($boss.poz)
echo "Distanța nouă față de origine: " + $dist_finala
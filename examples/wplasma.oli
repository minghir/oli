# --- OPTIMIZARE ---
config echo off
config max_iterations 0

# --- SETUP ---
plugin "x64/Release/oli_plugin"

plugin "x64/Release/oli_wcanvas"
plugin "x64/Release/oli_fract"
# --- CONFIG ---


set $SW = 640
set $SH = 480
set $v = CAN_INIT($SW, $SH, "Oli Fractal Trinity (1-3 to switch)")
set $ptr = CAN_GET_PTR()

set $mode = 1
set $zoom = 1.0

while true do
    # Schimbă modul de vizualizare
    if KEY_STATE(49) == 1 then set $mode = 1 endif # Tasta 1
    if KEY_STATE(50) == 1 then set $mode = 2 endif # Tasta 2
    if KEY_STATE(51) == 1 then set $mode = 3 endif # Tasta 3

    if $mode == 1 then
        set $t = TIME() * 20
        set $v = FRACT_JULIA($ptr, $SW, $SH, 0.7 * COS($t), 0.27 * SIN($t * 0.5), 32)
    endif

    if $mode == 2 then
        set $v = FRACT_MANDEL($ptr, $SW, $SH, $zoom, -0.5, 0)
        # Zoom automat pentru demo
        set $zoom = $zoom * 1.01
        if $zoom > 500 then set $zoom = 1.0 endif
    endif

    if $mode == 3 then
        set $v = FRACT_PLASMA($ptr, $SW, $SH, TIME() * 2)
    endif

    set $v = CAN_PRESENT()

    if KEY_STATE(81) == 1 then break endif
endwhile

set $v = CAN_CLOSE()
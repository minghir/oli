plugin "oli_xui"
config echo off

echo "=== Lansare Interfata Grafica GTK (XUI) ==="

# =================================================================
# DEFINE CLASA DE BAZA UiControl (Identica pt portabilitate)
# =================================================================
def class UiControl { 
    id, 
    set_prop($name, $val), 
    get_prop($name), 
    bind($event, $func),
    bind_arg($event, $func),
    set_text($text),
    get_text(),
    set_anchor($type),
    set_width_mode($mode),
    set_height_mode($mode),
    set_margin($val),
    set_visible($bool),
    set_font_size($size),
    set_height($val)
}

func UiControl::set_prop($name, $val) return UI_SET_PROPERTY($this, $name, $val) endfunc
func UiControl::get_prop($name)       return UI_GET_PROPERTY($this, $name) endfunc
func UiControl::bind($event, $func)   return UI_BIND_EVENT($this.id, $event, $func) endfunc
func UiControl::bind_arg($event, $func) return UI_BIND_ARG_EVENT($this.id, $event, $func) endfunc
func UiControl::set_text($text)       return $this.set_prop("text", $text) endfunc
func UiControl::get_text()            return $this.get_prop("text") endfunc
func UiControl::set_anchor($type)     return $this.set_prop("anchor", $type) endfunc
func UiControl::set_width_mode($mode) return $this.set_prop("width_mode", $mode) endfunc
func UiControl::set_height_mode($mode) return $this.set_prop("height_mode", $mode) endfunc
func UiControl::set_margin($val)      return $this.set_prop("margin", $val) endfunc
func UiControl::set_visible($bool)    return $this.set_prop("visible", $bool) endfunc
func UiControl::set_font_size($size)  return $this.set_prop("font_size", $size) endfunc
func UiControl::set_height($val)      return $this.set_prop("height", $val) endfunc

# =================================================================
# INCAPSULARE XAPP (GTK Init)
# =================================================================
def class XApp { create(), init(), run() }

func XApp::create()
    $this = CREATE_XAPP()
    return $this
endfunc

func XApp::init()
    $this = $this.create()
    return XAPP::INIT($this)
endfunc

func XApp::run()
    return XAPP::RUN($this)
endfunc

# =================================================================
# INCAPSULARE XWINDOW
# =================================================================
def class XWindow extends UiControl { id, title, init($id, $title), show(), set_layout($style) }

func XWindow::init($id, $title)
    $this.id = $id
    $this = CREATE_XWINDOW($id, $title)
    return $this
endfunc

func XWindow::show()
    return XWINDOW::SHOW($this)
endfunc

func XWindow::set_layout($style)
    return UI_SET_PROPERTY($this, "layout", $style)
endfunc

# =================================================================
# CONTROALE GTK
# =================================================================
def class XPanel extends UiControl { init($id, $parentId, $x, $y, $w, $h), set_layout($style) }

func XPanel::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("PANEL", $id, $parentId, $x, $y, $w, $h)
endfunc

# 🔥 ACEASTA LIPSEA: Trimite apelul din script către UI_CALL_METHOD din C++
func XPanel::set_layout($style)
    return UI_CALL_METHOD($this.id, "set_layout", $style)
endfunc

def class XButton extends UiControl { init($id, $parentId, $x, $y, $w, $h, $text) }
func XButton::init($id, $parentId, $x, $y, $w, $h, $text)
    $this.id = $id
    UI_CREATE_CONTROL("BUTTON", $id, $parentId, $x, $y, $w, $h, $text)
endfunc

def class XCodeView extends UiControl { init($id, $parentId, $x, $y, $w, $h), set_syntax_path($path) }
func XCodeView::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("CODEVIEW", $id, $parentId, $x, $y, $w, $h)
endfunc

func XCodeView::set_syntax_path($path)
    return $this.set_prop("syntax_path", $path)
endfunc

# =================================================================
# CLASA XTABCONTROL (Adăugată pentru suportul Multi-Tab din IDE)
# =================================================================
def class XTabControl extends UiControl { init($id, $parentId, $x, $y, $w, $h), add_tab($title, $pageId), switch_page($idx), select_tab_by_id($id), set_title_by_id($id, $title), refresh() }
func XTabControl::init($id, $parentId, $x, $y, $w, $h) 
    $this.id = $id 
    UI_CREATE_CONTROL("TABCONTROL", $id, $parentId, $x, $y, $w, $h) 
endfunc

func XTabControl::add_tab($title, $pageId) 
    return UI_CALL_METHOD($this.id, "add_tab", $title, $pageId) 
endfunc

func XTabControl::switch_page($idx)
    return UI_CALL_METHOD($this.id, "switch_page", $idx) 
endfunc

func XTabControl::select_tab_by_id($id) 
    return UI_CALL_METHOD($this.id, "select_tab_by_id", $id) 
endfunc

func XTabControl::set_title_by_id($id, $title)
    return UI_CALL_METHOD($this.id, "set_title_by_id", $id, $title) 
endfunc

func XTabControl::refresh() 
    return UI_CALL_METHOD($this.id, "refresh") 
endfunc

# =================================================================
# CLASA XMENU (Extinsă cu metodele lipsă apelate în script)
# =================================================================
def class XMenu extends UiControl { init($id, $parentId), add_item($itemId, $text), add_separator($sepId), add_submenu($text, $subMenuObj) }

func XMenu::init($id, $parentId)
    $this.id = $id
    UI_CREATE_CONTROL("MENU", $id, $parentId)
    return $this
endfunc

func XMenu::add_item($itemId, $text)
    return UI_CALL_METHOD($this.id, "add_item", $itemId, $text)
endfunc

func XMenu::add_separator($sepId)
    return UI_CALL_METHOD($this.id, "add_separator", $sepId)
endfunc

func XMenu::add_submenu($text, $subMenuObj)
    return UI_CALL_METHOD($this.id, "add_submenu", $text, $subMenuObj.id)
endfunc

# =================================================================
# CLASELE RICHEDIT / XRICHCONSOLE
# =================================================================
def class XRichEdit extends UiControl { init($id, $parentId, $x, $y, $w, $h), append_text($text) }
func XRichEdit::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("RICHEDIT", $id, $parentId, $x, $y, $w, $h)
endfunc
func XRichEdit::append_text($text) return UI_CALL_METHOD($this.id, "append_text", $text) endfunc

def class XRichConsole extends UiControl { init($id, $parentId, $x, $y, $w, $h), set_read_only($bool), set_font_size($size), set_resizable($bool) }
func XRichConsole::init($id, $parentId, $x, $y, $w, $h) $this.id = $id; UI_CREATE_CONTROL("RICHCONSOLE", $id, $parentId, $x, $y, $w, $h); endfunc
func XRichConsole::set_read_only($bool) return $this.set_prop("read_only", $bool) endfunc
func XRichConsole::set_font_size($size) return $this.set_prop("font_size", $size) endfunc
func XRichConsole::set_resizable($bool) return $this.set_prop("resizable", $bool) endfunc


# =================================================================
# CLASA FileDialog (Asigură maparea OOP pentru Dialogurile Native)
# =================================================================
def class FileDialog { title, type, show() } // ✅ FIX: show() a fost adăugat în blueprint!

func FileDialog::show()
    # Setăm valori implicite sigure în cazul în care scriptul nu le definește
    if $this.type == NULL then $this.type = 0 endif
    if $this.title == NULL then $this.title = "Selectează un fișier..." endif
    
    # Apelăm funcția nativă din plugin-ul C++ care deschide GtkFileChooserDialog
    return UI_FILE_DIALOG($this.type, $this.title)
endfunc

echo "AM DEFINIT CLASELE XUI"
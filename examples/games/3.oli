# --- CONFIGURARE ---
plugin "x64/Release/oli_console.dll"
plugin "x64/Release/oli_plugin.dll"

set $SW = 80
set $SH = 25
set $v = CON_SCREEN($SW, $SH)
set $v = DB_INIT($SW, $SH)
set $v = CURSOR(0)

# --- ENTITĂȚI ---
set $stars = []
for $i = 0 to 35 do
    set $v = PUSH($stars, { "x": RANDOM(0, 79), "y": RANDOM(0, 24) })
endfor

set $enemies = []
for $i = 0 to 9 do
    set $v = PUSH($enemies, { "x": RANDOM(10, 70), "y": RANDOM(2, 6), "d": 1, "alive": 1 })
endfor

# Definiție BOSS (5 HP, 5x2 dimensiune)
set $boss = { "x": 40, "y": -5, "d": 1, "hp": 5, "active": 0 }

set $bullets = []
set $px = 40
set $py = 22
set $cooldown = 0
set $run = true
set $victory = false

# --- GAME LOOP ---
while $run do
    # 1. FUNDAL
    cycle $stars as $s do
        set $s["y"] = $s["y"] + 1
        if $s["y"] > 24 then set $s["y"] = 0 endif
        set $v = DB_PUT($s["x"], $s["y"], ".", 8)
    endcycle

    # 2. INPUT (KEY_STATE)
    if KEY_STATE(37) == 1 then if $px > 2  then set $px = $px - 1 endif endif
    if KEY_STATE(39) == 1 then if $px < 77 then set $px = $px + 1 endif endif
    if KEY_STATE(38) == 1 then if $py > 10 then set $py = $py - 1 endif endif # Limită sus
    if KEY_STATE(40) == 1 then if $py < 24 then set $py = $py + 1 endif endif

    if $cooldown > 0 then set $cooldown = $cooldown - 1 endif
    if KEY_STATE(32) == 1 then
        if $cooldown == 0 then
            set $v = PUSH($bullets, { "x": $px, "y": $py - 1 })
            set $cooldown = 4
        endif
    endif
    if KEY_STATE(81) == 1 then set $run = false endif

    # 3. GLOANȚE
    cycle $bullets as $b do
        if $b["y"] > -1 then
            set $b["y"] = $b["y"] - 1
            if $b["y"] > 0 then set $v = DB_PUT($b["x"], $b["y"], "|", 11) endif
        endif
    endcycle

    # 4. LOGICĂ INAMICI MICI
    set $enemiesLeft = 0
    cycle $enemies as $en do
        if $en["alive"] == 1 then
            set $enemiesLeft = $enemiesLeft + 1
            set $en["x"] = $en["x"] + $en["d"]
            if $en["x"] > 77 then set $en["d"] = -1 endif
            if $en["x"] < 2  then set $en["d"] = 1  endif
            
            cycle $bullets as $b do
                if $b["y"] == $en["y"] then
                    if $b["x"] >= $en["x"] - 1 then
                        if $b["x"] <= $en["x"] + 1 then
                            set $en["alive"] = 0
                            set $b["y"] = -1
                        endif
                    endif
                endif
            endcycle
            
            if $en["alive"] == 1 then
                set $v = DB_PUT($en["x"] - 1, $en["y"], "<", 12)
                set $v = DB_PUT($en["x"],     $en["y"], "W", 12)
                set $v = DB_PUT($en["x"] + 1, $en["y"], ">", 12)
            endif
        endif
    endcycle

    # 5. LOGICĂ BOSS (Apare când mor toți inamicii mici)
    if $enemiesLeft == 0 then
        if $boss["hp"] > 0 then
            set $boss["active"] = 1
            
            # Coborâre Boss în arenă
            if $boss["y"] < 4 then set $boss["y"] = $boss["y"] + 0.1 endif
            
            # Mișcare laterală Boss
            set $boss["x"] = $boss["x"] + $boss["d"]
            if $boss["x"] > 74 then set $boss["d"] = -1 endif
            if $boss["x"] < 5  then set $boss["d"] = 1 endif

            # Coliziune Boss (Hitbox mare 5x2)
            cycle $bullets as $b do
                if $b["y"] >= $boss["y"] then
                    if $b["y"] <= $boss["y"] + 1 then
                        if $b["x"] >= $boss["x"] - 2 then
                            if $b["x"] <= $boss["x"] + 2 then
                                set $boss["hp"] = $boss["hp"] - 1
                                set $b["y"] = -1 # Glonțul dispare
                            endif
                        endif
                    endif
                endif
            endcycle

            # Randare BOSS (Culoarea 13 = Roz/Magenta)
            # Rândul 1: [MWM]
            set $v = DB_PUT($boss["x"] - 2, $boss["y"], "[", 13)
            set $v = DB_PUT($boss["x"] - 1, $boss["y"], "M", 13)
            set $v = DB_PUT($boss["x"],     $boss["y"], "W", 13)
            set $v = DB_PUT($boss["x"] + 1, $boss["y"], "M", 13)
            set $v = DB_PUT($boss["x"] + 2, $boss["y"], "]", 13)
            # Rândul 2:  V V
            set $v = DB_PUT($boss["x"] - 1, $boss["y"] + 1, "V", 13)
            set $v = DB_PUT($boss["x"] + 1, $boss["y"] + 1, "V", 13)
            
            # HP bar simplu deasupra Boss-ului
            set $v = DB_PUT($boss["x"] - 2, $boss["y"] - 1, "HP: ", 7)
			set $v = DB_PUT($boss["x"] + 2, $boss["y"] - 1, $boss["hp"], 10)
        else
            set $run = false
            set $victory = true
        endif
    endif

    # 6. JUCĂTOR & UI
    set $v = DB_PUT($px, $py, "A", 14)
    if $boss["active"] == 0 then
        set $v = DB_PUT(2, 1, "INAMICI:", 7)
        set $v = DB_PUT(10, 1, $enemiesLeft, 10)
    endif

    set $v = DB_PRESENT()
    set $v = SLEEP(16)
endwhile

# --- EXIT ---
set $v = KBD_RESTORE()
set $v = CURSOR(1)
set $v = CON_CLS()

if $victory == true then
    echo "FELICITARI! Boss-ul a fost distrus. Galaxia e libera!"
else
    echo "Ai fugit din lupta..."
endif
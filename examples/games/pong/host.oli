plugin oli_net
plugin oli_opengl
plugin oli_miniaudio

echo "=== PONG HOST (cu Sunet miniaudio) ==="

# 1. Inițializare Motor Audio & Încarcare Sunete
$audio_ok = SND_INIT()
if $audio_ok == 0 then
    echo "Avertisment: Nu s-a putut inițializa placa de sunet!"
endif

$snd_hit = SND_LOAD("hit.mp3")
$snd_score = SND_LOAD("score.wav")

$sock = NET_BIND(8080)
if $sock < 0 then return 0 endif

$client_ip = "192.168.88.37"
$client_port = 8081

# Stare Joc
$p1_y = 300
$p2_y = 300
$target_p2_y = 300

$ball_x = 400
$ball_y = 300
$ball_vx = 5
$ball_vy = 3

$score1 = 0
$score2 = 0
$max_score = 5
$game_state = 0
$winner = 0

$start_delay = 90

GL_INIT(800, 600, "Oli Pong 1v1 - HOST")

$running = 1
while $running do
    $m_y = GL_MOUSE_Y()
    if $m_y > 0 then $p1_y = $m_y endif

    # Rețea: Drenare UDP
    $drain = 1
    while $drain == 1 do
        $pkt = NET_RECV_FROM($sock)
        if HASKEY($pkt, "data") then
            $data_str = $pkt["data"]
            if $data_str != "" then
                $target_p2_y = INT($data_str)
            else
                $drain = 0
            endif
        else
            $drain = 0
        endif
    endwhile

    $p2_y = $p2_y + ($target_p2_y - $p2_y) * 0.35

    if $game_state == 0 then
        if $start_delay > 0 then
            $start_delay = $start_delay - 1
        endif
    endif

    # Fizică Minge & Sunete
    if $game_state == 0 then
        if $start_delay == 0 then
            $ball_x = $ball_x + $ball_vx
            $ball_y = $ball_y + $ball_vy

            # Coliziuni perete sus / jos
            if $ball_y <= 15 then
                $ball_y = 15
                $ball_vy = ABS($ball_vy)
                SND_PLAY($snd_hit)
            endif
            if $ball_y >= 585 then
                $ball_y = 585
                $ball_vy = ABS($ball_vy) * -1
                SND_PLAY($snd_hit)
            endif

            # Coliziune Paletă P1 (Stânga)
            if $ball_x <= 30 then
                if $ball_y >= ($p1_y - 50) then
                    if $ball_y <= ($p1_y + 50) then
                        $ball_x = 30
                        $ball_vx = ABS($ball_vx)
                        SND_PLAY($snd_hit)
                    endif
                endif
            endif

            # Coliziune Paletă P2 (Dreapta)
            if $ball_x >= 770 then
                if $ball_y >= ($p2_y - 50) then
                    if $ball_y <= ($p2_y + 50) then
                        $ball_x = 770
                        $ball_vx = ABS($ball_vx) * -1
                        SND_PLAY($snd_hit)
                    endif
                endif
            endif

            # GOL P2
            if $ball_x < 0 then
                $score2 = $score2 + 1
                $ball_x = 400
                $ball_y = 300
                $ball_vx = 5
                $ball_vy = 3
                $start_delay = 60
                SND_PLAY($snd_score)
                if $score2 >= $max_score then
                    $game_state = 1
                    $winner = 2
                endif
            endif

            # GOL P1
            if $ball_x > 800 then
                $score1 = $score1 + 1
                $ball_x = 400
                $ball_y = 300
                $ball_vx = -5
                $ball_vy = 3
                $start_delay = 60
                SND_PLAY($snd_score)
                if $score1 >= $max_score then
                    $game_state = 1
                    $winner = 1
                endif
            endif
        endif
    endif

    # Trimitere Stare
    $state = STR($p1_y) .. "," .. STR($ball_x) .. "," .. STR($ball_y) .. "," .. STR($score1) .. "," .. STR($score2) .. "," .. STR($game_state) .. "," .. STR($winner)
    NET_SEND_TO($sock, $client_ip, $client_port, $state)

    # Randare
    GL_CLEAR(0)
    GL_LINE(15, $p1_y - 40, 15, $p1_y + 40, 16777215)
    GL_LINE(785, $p2_y - 40, 785, $p2_y + 40, 16777215)
    GL_FILL_CIRCLE($ball_x, $ball_y, 10, 16776960)

    GL_TEXT(200, 30, "P1: " .. STR($score1))
    GL_TEXT(550, 30, "P2: " .. STR($score2))

    if $game_state == 0 then
        if $start_delay > 0 then
            GL_TEXT(330, 200, "PREGATESTE-TE!")
        endif
    endif

    if $game_state == 1 then
        if $winner == 1 then GL_TEXT(330, 280, "VICTORIE HOST (P1)!") endif
        if $winner == 2 then GL_TEXT(320, 280, "VICTORIE CLIENT (P2)!") endif
    endif

    $running = GL_PRESENT()
    WAIT(16)
endwhile

# Curățare Resurse
SND_CLOSE()
NET_CLOSE($sock)
GL_CLOSE()
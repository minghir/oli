plugin oli_time.dll
# 1. Resetare context
unset all
set $memo_pascal = MAP()
set $apeluri = 0

func PASCAL($n, $k)
    # Folosim @ pentru a modifica variabila globală
    set @apeluri = @apeluri + 1
    
    # Condiții de bază
    if $k == 0 then return 1 endif
    if $k == $n then return 1 endif

    # Generăm cheia (string) pentru cache
    set $key = "k" .. STR($n) .. "_" .. STR($k)
    echo "CHEIE:" .. $key
    # Verificăm cache-ul global
    if @memo_pascal[$key] != NULL then
        return @memo_pascal[$key]
    endif

    # Calcul recursiv (VM-ul gestionează automat cadrele de stivă)
    set $val1 = PASCAL($n - 1, $k - 1)
    set $val2 = PASCAL($n - 1, $k)
    
    # Rezultatul final al nodului curent
    set $res = $val1 + $val2

    # Salvăm în cache înainte de return
    set @memo_pascal[$key] = $res
    return $res
endfunc

echo "--- Test Recursivitate cu Memoization ---"
set $start = TICKS()
set $valoare = PASCAL(10, 5)
set $end = TICKS()

echo "Rezultat C(10, 5) = " + $valoare
echo "Total apeluri: " + $apeluri
echo "Durata: " + ($end - $start) + " ms"
echo $memo_pascal
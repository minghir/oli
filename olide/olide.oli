config win_app 0

plugin oli_system
plugin oli_filesys

include ("include\winui.oli")

# =================================================================
# CODUL PRINCIPAL (LOGICA DE SINCRONIZARE MULTI-TAB)
# =================================================================

$file = "" 
$oli_path = "oli.exe"
set $activeCodeView = null

# Funcție de sincronizare: Află ce tab e pe ecran și actualizează contextul IDE-ului
func UPDATE_ACTIVE_CONTEXT()
    # Întrebăm componenta C++ care este ID-ul panelului activ în acest moment
    $active_id = $tabs.get_prop("active_tab_id")
    
    if $active_id != "" then
        # Re-ancorăm dinamic obiectul de control pe ID-ul curent
        set $currentView = new("WinCodeView")
        $currentView.id = $active_id
        
        # Preluăm calea absolută pe care am salvat-o în el la deschidere
        @file = $currentView.get_prop("file_path")
        @activeCodeView = $currentView
    else
        @file = ""
        @activeCodeView = null
		init_first_tab()
    endif
endfunc

func GET_EXE_NAME($cale)
    $nume_fisier = FS_GET_FILENAME($cale)
    return REPLACE($nume_fisier, ".oli", ".exe")
endfunc

func run_click()
    # Sincronizăm contextul înainte de rulare ca să fim siguri că rulăm tab-ul corect
    UPDATE_ACTIVE_CONTEXT()

    if @file == "" then
        #SHOW_MESSAGE("IDE Error", "Nu există niciun fișier deschis în editor pentru a fi rulat!")
		menu_save_as_click()
        if @file != "" then run_click() endif
		return
    endif

    # 1. AUTO-SALVARE SILENȚIOASĂ
    echo "[IDE] Auto-salvare în fundal pentru: " .. @file
    $cod_curent = $activeCodeView.get_text()
    WRITEFILE(@file, $cod_curent)

    # 2. COMPILAREA ȘI EXECUTAREA
    echo "=== LANSARE COMPILARE ==="
    echo "Fișier sursă: " .. @file
    
    $compile_command = @oli_path .. " -c " .. @file
	echo "Compilez:" .. $compile_command
    $res = SYS($compile_command)
    echo $res
    
    $build_command = @oli_path .. " -b " .. @file
    echo "Rulez comanda: " .. $build_command
    
    $res = SYS($build_command)
    echo $res
    
    $exe_file = GET_EXE_NAME(@file)
    echo "LANSARE PROCES: " .. $exe_file
    
    START_PROCESS($exe_file)
endfunc

# =================================================================
# LOGICA DE SALVARE (SAVE / SAVE AS)
# =================================================================

func execute_save_to_disk($calea_fisiere)
    if @activeCodeView == null then return endif
    
    $cod_curent = $activeCodeView.get_text()
    WRITEFILE($calea_fisiere, $cod_curent)
    
    echo "[SUCCESS] Fișier salvat cu succes la: " .. $calea_fisiere
    SHOW_MESSAGE("Salvare", "Fișierul a fost salvat cu succes!")
endfunc

func menu_save_click()
    UPDATE_ACTIVE_CONTEXT()
    if @file != "" then
        execute_save_to_disk(@file)
    else
        menu_save_as_click()
    endif
endfunc

func menu_save_as_click()
    UPDATE_ACTIVE_CONTEXT()
	
	if @file == "" then
        #SHOW_MESSAGE("IDE Error", "Nu există niciun fișier deschis în editor pentru a fi rulat!")
		menu_save_as_click()
        if @file != "" then run_click() endif
		return
    endif
	
    if @activeCodeView == null then return endif

    set $dlg = new("FileDialog")
    $dlg.title = "Salvează fișierul sub alt nume..."
    $dlg.type = 1  
    
    $path = $dlg.show()
    if $path != "" then
        @file = $path  
        $activeCodeView.set_prop("file_path", $path) # Actualizăm proprietatea internă
        execute_save_to_disk(@file)
    endif
endfunc

func save_click()
    menu_save_click()
endfunc

func menu_new_click()
    echo "=== CREARE FIȘIER NOU ==="
    set $dlg = new("FileDialog")
    $dlg.title = "Creează un fișier nou Oli..."
    $dlg.type = 1  
    
    $path = $dlg.show()
    if $path != "" then
        @file = $path
        WRITEFILE(@file, "")
        
        # Deschidem fișierul nou direct într-un tab nou ca să poată fi editat separat!
        $newTabId = "tab_page_" .. FS_GET_FILENAME(@file)
        set $newView = new("WinCodeView")
        $newView.init($newTabId, "main_tabs", 0, 0, 0, 0)
        $newView.set_width_mode("FILL")
        $newView.set_height_mode("FILL")
        $newView.set_prop("file_path", @file) # 🔥 Reținem calea în C++
		$newView.set_font_size(14)
        
        $tabs.add_tab(FS_GET_FILENAME(@file), $newTabId)
        $newView.set_syntax_path("./olide/syntaxes/oli.xml")
        $newView.set_text("")
        $tabCount = $tabs.get_prop("tab_count")
        $tabs.switch_page($tabCount - 1)
        UPDATE_ACTIVE_CONTEXT()
        SHOW_MESSAGE("Fișier Nou", "Fișierul a fost creat și deschis în tab nou!")
    endif
endfunc

# 🔥 INTERCEPTĂM EVENIMENTUL DE CLOSE TAB
func menu_close_click()
    $active_id = $tabs.get_prop("active_tab_id")
    if $active_id != "" then
        echo "[IDE] Închid tab-ul curent: " .. $active_id
        
        # Apelăm metoda nativă din C++ pe care am adăugat-o în Pasul 1
        UI_CALL_METHOD($tabs.id, "remove_tab")
        
        # Actualizăm imediat contextul pentru a vedea ce fișier a rămas în focus
        UPDATE_ACTIVE_CONTEXT()
    endif
endfunc


func menu_exit_click()
	exit()
endfunc

func menu_about_click()
	set $about_text = "Oli Engine v0.1"
	SHOW_MESSAGE("About oli:",$about_text)
endfunc


func menu_interpreter_click()
	START_PROCESS(@oli_path)
endfunc

func menu_command_click()
	OPEN_TERMINAL()
endfunc

func menu_compile_click()
    UPDATE_ACTIVE_CONTEXT()
    if @file == "" then return endif

    $consoleOutput.set_text("=== [COMPILE] START ===\n")
    
    $compile_command = @oli_path .. " -c " .. @file
    echo "Execut: " .. $compile_command
    
    $res = SYS($compile_command)
    
    # Verificăm dacă rezultatul conține text sau dacă este gol
    if $res != "" then
        $consoleOutput.append_text($res .. "\n")
    else
        # Dacă $res este gol, compilarea a reușit fără avertismente/erori
        $consoleOutput.append_text("Compilare finalizată cu succes (fără erori).\n")
    endif
    
    $consoleOutput.append_text("=== [COMPILE] END ===\n")
endfunc

echo "CREEZ APP"
set $app = new("WinApp")
$app.init() 

echo "CREEZ WIN"
set $win = new("WinWindow")
$win.init("fereastra_principala", "Oli WINUI")
$win.set_icon("./olide/assets/Oli_Icon.ico")
$win.set_layout("GRID")


# =================================================================
# CREARE MENIU NATIV
# =================================================================
echo "CREEZ STRUCTURA DE MENIURI"

set $mainMenu = new("WinMenu")
$mainMenu.init("menu_principal", "fereastra_principala")

set $fileMenu = new("WinMenu")
$fileMenu.init("menu_file", "menu_principal")

# Adaugam elemente in meniul File
$fileMenu.add_item("menu_new", "New")
$fileMenu.add_item("menu_open", "Open...")
$fileMenu.add_item("menu_save", "Save")
$fileMenu.add_item("menu_save_as", "Save As...")
$fileMenu.add_item("menu_close", "Close File") # 🔥 Opțiunea Close adăugată în meniu!
$fileMenu.add_separator("sep_1")
$fileMenu.add_item("menu_exit", "Exit Application")

set $helpMenu = new("WinMenu")
$helpMenu.init("menu_help", "menu_principal")
$helpMenu.add_item("menu_about", "About Oli IDE")


set $toolsMenu = new("WinMenu")
$toolsMenu.init("menu_tools", "menu_principal")
$toolsMenu.add_item("menu_interpreter", "Interpreter")
$toolsMenu.add_item("menu_command", "Command prompt")

set $buildMenu = new("WinMenu")
$buildMenu.init("menu_build", "menu_principal")
$buildMenu.add_item("menu_build", "Build")
$buildMenu.add_item("menu_compile", "Compile")

$mainMenu.add_submenu("File", $fileMenu)
$mainMenu.add_submenu("Build", $buildMenu)
$mainMenu.add_submenu("Tools", $toolsMenu)
$mainMenu.add_submenu("Help", $helpMenu)

$win.set_prop("menu", "menu_principal")


# =================================================================
# BINDING CALL-BACKS
# =================================================================
$win.bind("menu_new", "menu_new_click")
$win.bind("menu_open", "menu_open_click")
$win.bind("menu_save", "menu_save_click")
$win.bind("menu_save_as", "menu_save_as_click") 
$win.bind("menu_close", "menu_close_click") # 🔥 Legăm funcția de butonul din meniu
$win.bind("menu_exit", "menu_exit_click")
$win.bind("menu_about", "menu_about_click")
$win.bind("menu_interpreter", "menu_interpreter_click")
$win.bind("menu_command", "menu_command_click")
$win.bind("menu_compile", "menu_compile_click")

# =================================================================
# INTERFAȚA GRAFICĂ (PANELS & CONTROLS)
# =================================================================
echo "CREEZ Main panel"
set $mainPanel = new("WinPanel")
$mainPanel.init("main_panel", "fereastra_principala",0,0,40,40)
$mainPanel.set_layout("VSTACK")
$mainPanel.set_width_mode("FILL")
$mainPanel.set_height_mode("FILL")
$mainPanel.set_margin(10)

echo "CREEZ act panel"
set $actPanel = new("WinPanel")
$actPanel.init("act_panel", "main_panel", 0,0,40,40)
$actPanel.set_layout("HSTACK")
$actPanel.set_width_mode("FILL")
$actPanel.set_height_mode("FIXED")
$actPanel.set_margin(10)

set $tabs = new("WinTabControl")
$tabs.init("main_tabs", "main_panel", 0, 0, 600, 400)
$tabs.set_width_mode("FILL")
$tabs.set_height_mode("FILL")

echo "CREEZ run button"
set $runButton = new("WinButton")

$runButton.init("btn_run", "act_panel", 10, 4, 80, 40, "▶")
$runButton.set_prop("font_name","Segoe UI Symbol")
$runButton.set_anchor("RIGHT|BOTTOM")
$runButton.set_width_mode("FIXED")

set $saveButton = new("WinButton")
$saveButton.init("btn_save", "act_panel", 95, 4, 80, 40, "💾")
$saveButton.set_anchor("RIGHT|BOTTOM")
$saveButton.set_width_mode("FIXED")

$runButton.bind("click", "run_click")
$saveButton.bind("click", "save_click")



# =================================================================
# CONSOLĂ COMPILARE (JOS)
# =================================================================
echo "CREEZ Consolă..."
set $consolePanel = new("WinPanel")
$consolePanel.init("console_panel", "main_panel", 0, 0, 0, 150) # Înălțime fixă 150px
#$consolePanel.set_layout("FILL") 
$consolePanel.set_layout("GRID")
$consolePanel.set_width_mode("FILL")
$consolePanel.set_height_mode("FIXED") # Fixăm înălțimea ca să nu ocupe tot

set $consoleOutput = new("WinRichConsole")
$consoleOutput.init("console_output", "console_panel", 0, 0, 100, 150)
$consoleOutput.set_width_mode("FILL")
$consolePanel.set_height_mode("FIXED")
$consoleOutput.set_read_only(true) # Utilizatorul nu poate scrie în ea
$consoleOutput.set_font_size(12)
$consoleOutput.set_text("Gata pentru compilare...")


# =================================================================
# LOGICA DE DESCHIDERE DINAMICĂ ACTUALIZATĂ
# =================================================================
set $counter = 0


func menu_open_click()
    set $dlg = new("FileDialog")
    $dlg.title = "Deschide fișierul Oli"
    $dlg.type = 0
    
    $path = $dlg.show()
    if $path != "" then
        $newTabId = "tab_page_" .. FS_GET_FILENAME($path)
        
        # 🔥 VERIFICARE DE SIGURANȚĂ: Încercăm să activăm tab-ul dacă este deja deschis!
        $alreadyOpen = $tabs.select_tab_by_id($newTabId)
        if $alreadyOpen == true then
            echo "[IDE] Fișierul '" .. FS_GET_FILENAME($path) .. "' este deja deschis. Mut focusul pe el!"
            UPDATE_ACTIVE_CONTEXT()
            return # Oprim execuția funcției aici, nu mai creăm nimic!
        endif
        
        # -----------------------------------------------------------------
        # Dacă codul trece de 'if', înseamnă că fișierul NU este deschis.
        # Continuăm cu logica ta normală de creare:
        # -----------------------------------------------------------------
        set $newView = new("WinCodeView")
        $newView.init($newTabId, "main_tabs", 0, 0, 0, 0)
        
        $newView.set_width_mode("FILL")
        $newView.set_height_mode("FILL")
        $newView.set_prop("file_path", $path)
        
        $tabs.add_tab(FS_GET_FILENAME($path) .. " ", $newTabId)
        
        $newView.set_syntax_path("./olide/syntaxes/oli.xml")
        $newView.set_text(READFILE($path))
        $newView.set_font_size(12)
        
        $tabCount = $tabs.get_prop("tab_count")
        $tabs.switch_page($tabCount - 1)
        
        UPDATE_ACTIVE_CONTEXT()
        @counter++
    endif
endfunc

func init_first_tab()
	$newTabId = "tab_page_" .. "untitled.oli"
	set $newView = new("WinCodeView")
    $newView.init($newTabId, "main_tabs", 0, 0, 0, 0)
    $newView.set_width_mode("FILL")
    $newView.set_height_mode("FILL")
	$newView.set_syntax_path("./olide/syntaxes/oli.xml")
	$tabs.add_tab("untitled.oli", $newTabId)
	$newView.set_font_size(12)
	UPDATE_ACTIVE_CONTEXT()
	$tabs.refresh()
	@counter++
endfunc

# =================================================================
# 🔥 EVENIMENT AUTOMAT: SCHIMBARE TAB PRIN CLICK SAU TASTE
# =================================================================

func on_tab_changed()
    echo "[IDE] Tab-ul a fost schimbat de utilizator! Actualizez contextul..."
    
    # Apelăm funcția ta magică de sincronizare
    UPDATE_ACTIVE_CONTEXT()
    
    # Log de verificare în consolă pentru a vedea dacă s-a mutat corect calea fișierului
    if @file != "" then
        echo "[IDE] Context nou activat: " .. @file
    else
        echo "[IDE] Ecran gol, nu există fișier activ."
    endif
endfunc
$tabs.bind("tab_changed", "on_tab_changed")

init_first_tab()
$win.show()  
$app.run()


echo "=== Aplicație închisă cu succes ==="
input()
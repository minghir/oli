# --- SETUP ---
config echo off
config max_iterations 0
plugin oli_canvas
plugin oli_fract   # Unde ai înregistrat FX_3D_SHAPES
plugin oli_keyboard
plugin oli_time

set $v = CAN_INIT(800, 600, "Oli 3D Engine - Cube & Sphere")
set $ptr = CAN_GET_PTR()
set $w = CAN_GET_WIDTH()
set $h = CAN_GET_HEIGHT()

echo "Randare 3D inceputa. Q pentru Iesire."
set $i = 1
while $i == 1 do
    set $t = TIME()
	echo $i
    # Apelăm funcția 3D
    set $res = FX_3D_SHAPES($ptr, $w, $h, $t)
    
    set $v = CAN_PRESENT()
    set $state = KEY_STATE(81)
    if $state > 0.5 then 
		set $i = 0 
	endif
	
endwhile


set $v = CAN_CLOSE()
echo "Revenire in consola."
list funcs
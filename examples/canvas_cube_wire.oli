config win_app 1

# --- SETUP ---


config echo off
config max_iterations 0

plugin oli_canvas
plugin oli_math
plugin oli_keyboard
plugin oli_time

func RENDER_WIRE_CUBE()
    set $W = 400; set $H = 400
    set $v = CAN_INIT($W, $H, "Oli 3D Wireframe")
    
    # --- DATE CUB ---
    #array $vx[8]; array $vy[8]; array $vz[8]
	
	
set $vx = ARRAY(8)
set $vy = ARRAY(8)
set $vz = ARRAY(8)
set $sx = ARRAY(8)
set $sy = ARRAY(8)
	
    # Baza de jos
    set $vx[0]=-1.5; set $vy[0]=-1.5; set $vz[0]=-1.5
    set $vx[1]= 1.5; set $vy[1]=-1.5; set $vz[1]=-1.5
    set $vx[2]= 1.5; set $vy[2]= 1.5; set $vz[2]=-1.5
    set $vx[3]=-1.5; set $vy[3]= 1.5; set $vz[3]=-1.5
    # Baza de sus
    set $vx[4]=-1.5; set $vy[4]=-1.5; set $vz[4]= 1.5
    set $vx[5]= 1.5; set $vy[5]=-1.5; set $vz[5]= 1.5
    set $vx[6]= 1.5; set $vy[6]= 1.5; set $vz[6]= 1.5
    set $vx[7]=-1.5; set $vy[7]= 1.5; set $vz[7]= 1.5

    # Array-uri pentru coordonatele proiectate 2D
    a#rray $sx[8]; array $sy[8]

    while true do
        set $v = CAN_CLS(0)
        set $t = TIME()
		set $t = $t * 25
		#echo $t
        set $color = 65280 # Verde Neon

        # 1. Proiecție 3D -> 2D
        for $i = 0 to 7 do
            set $x = $vx[$i]; set $y = $vy[$i]; set $z = $vz[$i]

            set $x1 = $x * COS($t) + $z * SIN($t)
            set $z1 = -1.0 * $x * SIN($t) + $z * COS($t)
            set $y2 = $y * COS($t * 0.5) - $z1 * SIN($t * 0.5)
            set $z2 = $y * SIN($t * 0.5) + $z1 * COS($t * 0.5)

            set $dist = $z2 + 6.0
            set $f = 400.0 / $dist
            set $sx[$i] = ($x1 * $f) + 200
            set $sy[$i] = ($y2 * $f) + 200
        endfor

        # 2. Desenare Muchii (Wireframe)
        # Legăm pătratul de jos
        set $v = CAN_LINE($sx[0], $sy[0], $sx[1], $sy[1], $color)
        set $v = CAN_LINE($sx[1], $sy[1], $sx[2], $sy[2], $color)
        set $v = CAN_LINE($sx[2], $sy[2], $sx[3], $sy[3], $color)
        set $v = CAN_LINE($sx[3], $sy[3], $sx[0], $sy[0], $color)
        
        # Legăm pătratul de sus
        set $v = CAN_LINE($sx[4], $sy[4], $sx[5], $sy[5], $color)
        set $v = CAN_LINE($sx[5], $sy[5], $sx[6], $sy[6], $color)
        set $v = CAN_LINE($sx[6], $sy[6], $sx[7], $sy[7], $color)
        set $v = CAN_LINE($sx[7], $sy[7], $sx[4], $sy[4], $color)
        
        # Legăm cele două baze (stâlpii verticali)
        set $v = CAN_LINE($sx[0], $sy[0], $sx[4], $sy[4], $color)
        set $v = CAN_LINE($sx[1], $sy[1], $sx[5], $sy[5], $color)
        set $v = CAN_LINE($sx[2], $sy[2], $sx[6], $sy[6], $color)
        set $v = CAN_LINE($sx[3], $sy[3], $sx[7], $sy[7], $color)

        set $v = CAN_PRESENT()
        if KEY_STATE(81) == 1 then break; endif
    endwhile
endfunc

set $res = RENDER_WIRE_CUBE()
config echo off
config max_iterations 0

plugin oli_canvas
plugin oli_fract
plugin oli_keyboard

set $v = CAN_INIT(800, 600, "Sphere in Torus 3D")
set $ptr = CAN_GET_PTR()
set $w = CAN_GET_WIDTH()
set $h = CAN_GET_HEIGHT()

set $t = 0.0
set $speed = 0.016
set $i = 1
while $i == 1 do
    set $t = $t + $speed

    set $res = FX_SPHERE_TORUS($ptr, $w, $h, $t)
    set $v = CAN_PRESENT()

    set $v = WAIT(16)
	
	set $state = KEY_STATE(81) 
    if $state > 0.5 then 
		set $i = 0
	endif

	set $state2 = KEY_STATE(32) 
    if $state2 > 0.5 then
        set $speed = $speed + 0.002
    endif
endwhile

set $v = CAN_CLOSE()

plugin oli_miniaudio
plugin oli_math

echo "Generăm laserul... de data asta va suna cum trebuie!"

set $sampleRate = 22050  # 22kHz e suficient și mai rapid de calculat
set $duration = 0.4
set $numSamples = $sampleRate * $duration
set $samples = array($numSamples)

set $fStart = 1500.0
set $fEnd = 150.0
set $PI = 3.14159265
set $phase = 0.0 # <--- SECRETUL: Faza începe de la 0

for $i = 0 to $numSamples - 1 do
    set $progress = $i / $numSamples
    
    # 1. Calculăm frecvența curentă
    #set $currentFreq = $fStart - ($progress * ($fStart - $fEnd))
	set $currentFreq = LERP($fStart, $fEnd, $progress)
    
    # 2. Generăm eșantionul folosind faza cumulată
    set $val = SINR($phase)
    
    # 3. Actualizăm faza pentru eșantionul următor
    # Formula: 2 * PI * Freq / SampleRate
    set $phaseStep = 2.0 * $PI * $currentFreq / $sampleRate
    set $phase = $phase + $phaseStep
    
    # 4. Volumul scade (Envelope)
    set $amplitude = 1.0 - $progress
    set $samples[$i] = $val * $amplitude
endfor

SND_SAVE_WAV("./examples/games/winvaders/laser_oli.wav", $samples, $sampleRate)
echo "Gata! Încearcă acum fișierul."
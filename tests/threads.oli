plugin oli_threads

$cores = GET_CPU_CORES()
echo "Numar de nuclee CPU detectate: " .. STR($cores)

func worker_task($id)
    echo "Worker #" .. STR($id) .. " ruleaza pe un nucleu dedicat."
    return $id
endfunc

$handles = ARRAY()

# 1. Lansăm câte un worker per nucleu și salvăm handle-urile cu PUSH
for $i = 1 to $cores do
    $h = THREAD_SPAWN("worker_task", $i)
    PUSH($handles, $h)
endfor

# 2. Extragere ordonată din coadă cu SHIFT și așteptare cu THREAD_WAIT
for $i = 1 to $cores do
    $h = SHIFT($handles)
    THREAD_WAIT($h)
endfor

echo "Toate cele " .. STR($cores) .. " thread-uri au fost procesate cu succes!"
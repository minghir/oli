# =================================================================
# BINDING CALL-BACKS
# =================================================================
$win.bind("menu_new", "menu_new_click")
$win.bind("menu_open", "menu_open_click")
$win.bind("menu_save", "menu_save_click")
$win.bind("menu_save_as", "menu_save_as_click") 
$win.bind("menu_close", "menu_close_click") # 🔥 Legăm funcția de butonul din meniu
$win.bind("menu_exit", "menu_exit_click")
$win.bind("menu_about", "menu_about_click")
$win.bind("menu_interpreter", "menu_interpreter_click")
$win.bind("menu_command", "menu_command_click")
$win.bind("menu_compile", "menu_compile_click")
$win.bind("menu_build", "menu_build_click")

# =================================================================

plugin oli_math

# 1. Definire Structuri
def struct vec2 {x, y}

# 2. Configurare
set $w = 512
set $h = 512
set $iResolution = new("vec2")
set $iResolution.x = 512.0
set $iResolution.y = 512.0

set $data = array(1 + ($w * $h * 3))
set $data[0] = "P6 512 512 255\n"

echo "Randare MultiSmoothStep shader..."

for $py = 0 to $h - 1 do
    for $px = 0 to $w - 1 do
        
        # vec2 uv = fragCoord / iResolution.xy
        set $uv = new("vec2")
        set $uv.x = 1.0 * $px / $iResolution.x
        set $uv.y = 1.0 * $py / $iResolution.y
        
        set $m = 10.0
        set $steps = 5.0
        
        # --- Calcul X (multiSmoothStep) ---
        set $sx = $steps * $uv.x
        set $fx = $sx - floor($sx) # fract(sx)
        set $baseX = floor($sx) / $steps
        
        # smoothstep(0.0, 1.0, m * f)
        set $tX = $m * $fx
        if $tX < 0.0 then set $tX = 0.0 endif
        if $tX > 1.0 then set $tX = 1.0 endif
        set $smoothX = $tX * $tX * (3.0 - 2.0 * $tX)
        set $finalX = $baseX + ($smoothX / $steps)
        
        # --- Calcul Y (multiSmoothStep) ---
        set $sy = $steps * $uv.y
        set $fy = $sy - floor($sy) # fract(sy)
        set $baseY = floor($sy) / $steps
        
        # smoothstep(0.0, 1.0, m * f)
        set $tY = $m * $fy
        if $tY < 0.0 then set $tY = 0.0 endif
        if $tY > 1.0 then set $tY = 1.0 endif
        set $smoothY = $tY * $tY * (3.0 - 2.0 * $tY)
        set $finalY = $baseY + ($smoothY / $steps)
        
        # 3. Output to Screen (fragColor = vec4(xy, 0.0, 1.0))
        set $idx = 1 + (($py * $w + $px) * 3)
        set $data[$idx]     = $finalX * 255 # Canal R
        set $data[$idx + 1] = $finalY * 255 # Canal G
        set $data[$idx + 2] = 0           # Canal B
        
    endfor
    if ($py % 128) == 0 then echo "Progres: " + (($py / $h) * 100) + "%" endif
endfor

writefile("multistep_pattern.ppm", $data)
echo "Imagine generata! Ar trebui sa vezi o grila de gradiente line."
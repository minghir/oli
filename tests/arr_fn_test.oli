echo "=== TEST MANIPULARE MAP ==="

$m = MAP()
$m["nume"] = "Oli Engine"
$m["versiune"] = 0.2
$m["autor"] = "Minghir"

echo "1. Map initial: " .. STR($m)

# 2. HASKEY - Verificare existență chei
$has_nume = HASKEY($m, "nume")
$has_pret = HASKEY($m, "pret")
echo "2. HASKEY('nume'): " .. STR($has_nume) .. " | HASKEY('pret'): " .. STR($has_pret)

# 3. KEYS - Extragere chei sub formă de Array
$chei = KEYS($m)
echo "3. Chei extrase cu KEYS: " .. STR($chei)

# 4. VALUES - Extragere valori sub formă de Array
$valori = VALUES($m)
echo "4. Valori extrase cu VALUES: " .. STR($valori)
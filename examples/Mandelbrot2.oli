unset all
set $width = 60
set $height = 30
set $max_iter = 20
set @memo = array()

set $step_y = 2.0 / $height
set $step_x = 3.0 / $width

set $py = 0
while $py < $height do
    set $line = ""
    set $y0 = ($py * $step_y) - 1.0
    
    # Coordonata simetrică pentru căutare în "oglindă"
    set $sym_py = ($height - 1) - $py
    
    set $px = 0
    while $px < $width do
        set $key = $px + "_" + $sym_py
        
        # --- BLOCUL DE OPTIMIZARE ---
        if @memo[$key] != null then
            set $iter = @memo[$key]
        else
            set $x0 = ($px * $step_x) - 2.0
            set $zx = 0.0
            set $zy = 0.0
            set $iter = 0
            while $iter < $max_iter do
                set $zx2 = $zx * $zx
                set $zy2 = $zy * $zy
                if ($zx2 + $zy2) > 4.0 then break endif
                set $zy = (2.0 * $zx * $zy) + $y0
                set $zx = $zx2 - $zy2 + $x0
                set $iter = $iter + 1
            endwhile
            
            # Salvăm pentru a fi refolosit de rândul simetric
            set $current_key = $px + "_" + $py
            set @memo[$current_key] = $iter
        endif  # <--- AICI era lipsa care îl bloca!
        
        # --- REDARE VIZUALĂ ---
        set $char = " "
        if $iter == $max_iter then 
            set $char = "#" 
        else if $iter > 10 then 
            set $char = "*" 
        else if $iter > 5 then 
            set $char = "." 
        endif
		endif
		endif
        
        set $line = $line + $char
        set $px = $px + 1
    endwhile
    
    echo $line
    set $py = $py + 1
endwhile
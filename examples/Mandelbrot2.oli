unset all

config echo off
config max_iterations 0

set $width = 60
set $height = 30
set $max_iter = 20

# 60 width * 30 height = 1800 de celule pentru a acoperi tot ecranul
set @memo = array(1800)

set $step_y = 2.0 / $height
set $step_x = 3.0 / $width

set $py = 0
while $py < $height do
    set $line = ""
    set $y0 = ($py * $step_y) - 1.0
    
    # Coordonata simetrică pe axa Y (linia corespondentă în oglindă)
    set $sym_py = ($height - 1) - $py
    
    set $px = 0
    while $px < $width do
        

        # Calculăm indicii numerici liniari (aplatizați) pentru array
        set $idx_curent = ($py * $width) + $px
        set $idx_oglinda = ($sym_py * $width) + $px
        
        # --- BLOCUL DE OPTIMIZARE PRIN SIMETRIE ---
        # Dacă linia curentă este în a doua jumătate, înseamnă că oglinda ei 
        # de sus a fost DEJA calculată structural! Citim direct din ea.
        if $py >= 15 then
            set $iter = @memo[$idx_oglinda]
        else
            # Suntem în prima jumătate, deci calculăm normal Mandelbrot
            set $x0 = ($px * $step_x) - 2.0
            set $zx = 0.0
            set $zy = 0.0
            set $iter = 0
            
            while $iter < $max_iter do
                set $zx2 = $zx * $zx
                set $zy2 = $zy * $zy
                
                if ($zx2 + $zy2) > 4.0 then 
                    break 
                endif
                
                set $zy = (2.0 * $zx * $zy) + $y0
                set $zx = $zx2 - $zy2 + $x0
                set $iter = $iter + 1
            endwhile
            
            # Salvăm valoarea în memorie pentru a fi folosită ulterior de cealaltă jumătate
            set @memo[$idx_curent] = $iter
        endif
        
        # --- REDARE VIZUALĂ (Sintaxă curată pentru Parser) ---
        set $char = " "
        if $iter == $max_iter then 
            set $char = "#" 
        else
            if $iter > 10 then 
                set $char = "*" 
            else
                if $iter > 5 then 
                    set $char = "." 
                endif
            endif
        endif
        
        set $line = $line + $char
        set $px = $px + 1
    endwhile
    
    echo $line
    set $py = $py + 1
endwhile 

input()
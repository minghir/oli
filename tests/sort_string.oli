unset all; cls

func COUNT_ARR arr_to_count
set $i=0
  cycle $arr_to_count as val do 
	set $i = $i + 1
	endcycle
  return $i
endfunc

func SORT_STRINGS array
    set $arr = $array
    set $i = 0;
    set $n = COUNT_ARR($arr)
	if $n == moonstate then echo "eroare"; return moonstate; endif
    while $i < $n do 
        set $j = $i + 1 
        while $j < $n do 
            if $arr[$i] > $arr[$j] then 
                set $temp = $arr[$i]
                set $arr[$i] = $arr[$j]
                set $arr[$j] = $temp
            endif 
            set $j = $j + 1
        endwhile 
        set $i = $i + 1 
    endwhile
	 cycle $arr as val do echo "in func:" + $val endcycle
	 dm
    return $arr
endfunc

set $test=["unu","doi","trei","patru"]
set $res = SORT_STRINGS($test)

cycle $res as val do echo $val endcycle 


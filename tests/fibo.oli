
plugin oli_plugin.dll
# 1. Resetăm mediul
unset all
set $memo = []

# 2. Definim funcția cu Memoization
func FIBO_MEMO n
    if $n <= 1 then 
        # Când ajungem la finalul recursivității, vedem drumul parcurs
        if $n == 0 then
            #echo "--- Debug: Am ajuns la baza n=0. Trace stivă: ---"
            #trace
        endif
        return $n 
    endif

    if @memo[$n] != NULL then 
        return @memo[$n] 
    endif

    set $res = FIBO_MEMO($n - 1) + FIBO_MEMO($n - 2)
    set global @memo[$n] = $res
    
    return $res
endfunc



# 3. Test de Scoping (Verificăm dacă funcțiile pot scrie în Global)
set $test_global = "Original"
func TEST_SCOPE
    set $test_global = "Modificat"
endfunc

# --- EXECUȚIE ---

echo "--- Test 1: Scoping ---"
TEST_SCOPE()
echo "Valoare globala dupa apel: " + $test_global
# Daca afiseaza "Original", inseamna ca setVariable NU urca in Call Stack.

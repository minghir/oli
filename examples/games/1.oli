# --- SETUP ---
plugin "x64/Release/oli_console.dll"
plugin "x64/Release/oli_plugin.dll"

set $SW = 80
set $SH = 25
$v = CON_SCREEN($SW, $SH)
$v = DB_INIT($SW, $SH)
$v = CURSOR(0)

# --- ENTITĂȚI ---
set $stars = []
for $i = 0 to 29 do
    $v = PUSH($stars, { "x": RANDOM(0, 79), "y": RANDOM(0, 24) })
endfor

set $enemies = []
set $enemyCount = 8  # Câți inamici vrei să măcelărești
for $i = 0 to $enemyCount - 1 do
    $v = PUSH($enemies, { "x": RANDOM(10, 70), "y": RANDOM(2, 8), "d": 1, "alive": 1 })
endfor

set $bullets = []
set $px = 40
set $py = 22
set $run = true

# --- GAME LOOP ---
while $run do
    # 1. STELE
    cycle $stars as $s do
        set $s["y"] = $s["y"] + 1
        if $s["y"] > 24 then set $s["y"] = 0 endif
        $v = DB_PUT($s["x"], $s["y"], ".", 8)
    endcycle

    # 2. INPUT & TRAGERE
    set $k = GET_KEY()
    if $k == 32 then
        $v = PUSH($bullets, { "x": $px, "y": $py - 1 })
    endif

    # 3. GLOANȚE
    cycle $bullets as $b do
        set $b["y"] = $b["y"] - 1
        if $b["y"] > 0 then
            $v = DB_PUT($b["x"], $b["y"], "|", 11)
        endif
    endcycle

    # 4. LOGICĂ INAMICI & CONDIȚIE DE VICTORIE
    set $enemiesLeft = 0  # Resetăm numărătoarea la fiecare cadru
    
    cycle $enemies as $en do
        if $en["alive"] == 1 then
            set $enemiesLeft = $enemiesLeft + 1
            
            # Mișcare
            set $en["x"] = $en["x"] + $en["d"]
            if $en["x"] > 75 then set $en["d"] = -1 endif
            if $en["x"] < 5  then set $en["d"] = 1 endif
            
            # Verificăm dacă a fost lovit
            cycle $bullets as $b do
                if $b["x"] == $en["x"] then
                    if $b["y"] == $en["y"] then
                        set $en["alive"] = 0
                        set $b["y"] = -1 # Glonțul dispare
                    endif
                endif
            endcycle
            
            # Desenăm inamicul viu
            $v = DB_PUT($en["x"], $en["y"], "W", 12)
        endif
    endcycle

    # VERIFICĂM DACĂ MAI EXISTĂ SUPRAVIEȚUITORI
    if $enemiesLeft == 0 then
        set $run = false
        set $victory = true
    endif

    # 5. JUCĂTOR
    if $k == 1001 then if $py > 0  then set $py = $py - 1 endif endif
    if $k == 1002 then if $py < 24 then set $py = $py + 1 endif endif
    if $k == 1003 then if $px > 0  then set $px = $px - 1 endif endif
    if $k == 1004 then if $px < 79 then set $px = $px + 1 endif endif
    if $k == 113 then set $run = false endif

    $v = DB_PUT($px, $py, "A", 14)
    
    # Afișăm scorul/inamicii rămași (direct în buffer!)
    # Folosim o poziție fixă sus
    $v = DB_PUT(2, 1, "INAMICI:", 7)
    $v = DB_PUT(10, 1, $enemiesLeft, 10)

    # 6. FLIP
    $v = DB_PRESENT()
    $v = SLEEP(16)
endwhile

# --- FINAL ---
$v = CURSOR(1)
$v = CON_CLS()

if $victory == true then
    echo "FELICITARI! Galaxia este curata. Esti cel mai bun pilot!"
else
    echo "Ai abandonat misiunea..."
endif
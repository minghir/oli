# --- CONFIGURARE ENGINE ---
plugin "oli_plugin/oli_plugin"
config max_iterations 0
include("examples/tinybasic/int_sort.oli")
cls; unset all

# --- INIȚIALIZARE MEMORIE ---
set $tb_program = MAP()
set $tb_vars = ARRAY()
for $i = 0 to 25 do PUSH($tb_vars, 0) endfor
set $tb_jump_to = -1 
set $tb_gosub_stack = ARRAY()  # <--- NOU: Stiva pentru GOSUB
set $pc = -1

func tb_split $line
    set $result = ARRAY()
    set $current_tok = ""
    set $in_quotes = false
    set $len = LEN($line)
    
    for $i = 0 to $len - 1 do
        set $char = SUBSTR($line, $i, 1)
        
        # Folosim codul ASCII 34 pentru ghilimele
        if ASC($char) == 34 then
            if $in_quotes == true then 
                set $in_quotes = false 
            else 
                set $in_quotes = true 
            endif
            set $current_tok = $current_tok + $char
        else 
            # Verificăm spațiul (ASCII 32) sau string-ul " "
            if $char == " " && $in_quotes == false then
                if $current_tok != "" then
                    $void = PUSH($result, $current_tok)
                    set $current_tok = ""
                endif
            else
                set $current_tok = $current_tok + $char
            endif
        endif
    endfor
    
    if $current_tok != "" then
        $void = PUSH($result, $current_tok)
    endif
    return $result
endfunc

# --- HELPER: PARSER DE EXPRESII ---
func tbasic_parse_expr $p_expr
    set $p_e = TRIM($p_expr)
    
    set $first_c = SUBSTR($p_e, 0, 1)
    if ASC($first_c) == 34 then
        return REPLACE($p_e, CHAR(34), "")
    endif
    
    set $p_work = UPPER($p_e)
    for $idx = 0 to 25 do
        set $char_to_rep = CHR(65 + $idx)
        set $p_work = REPLACE($p_work, $char_to_rep, STR($tb_vars[$idx]))
    endfor
    
    return EVAL($p_work)
endfunc

# --- FUNCȚIE: EXECUTĂ O LINIE ---
func tbasic_exec_line $line_content

#echo "Execut:{"+$line_content+"}"

	set $l_c = TRIM($line_content)
	if $l_c == "" then 
		return 0 
	endif
	#echo "Aici inainte de splict:" + $l_c
	set $p_parts = TB_SPLIT($l_c)
	#echo "Aici dupa split:" + STR($p_parts)
	set $p_cmd = UPPER($p_parts[0])
	#echo "COMANDA($p_cmd): {" + $p_cmd +"}"
	
	#echo "INAINTE DE LET"
	if $p_cmd == "LET" then
		##echo "SUNT in LET"
		set $eq_pos = FIND($l_c, "=")
		##echo "eq_pos=" + $eq_pos
		set $v_name = TRIM(SUBSTR($l_c, 4, $eq_pos - 4))
		##echo "V name=" + $v_name
		set $v_idx = ASC(UPPER($v_name)) - 65
		##echo "v_idx=" + $v_idx
		set $de_evaluat = SUBSTR($l_c, $eq_pos + 1)
		#echo "De evaluat:" + $de_evaluat
		set @tb_vars[$v_idx] = tbasic_parse_expr($de_evaluat)
		#echo "tb_vars=" + $tb_vars[$v_idx]
		return 1
	endif
	
	
	if $p_cmd == "IF" then
		set $u_l = UPPER($l_c)
		set $t_p = FIND($u_l, " THEN ")
		set $cond = SUBSTR($l_c, 3, $t_p - 3)
		set $act = TRIM(SUBSTR($l_c, $t_p + 6))
		
		set $test = tbasic_parse_expr($cond)
		
		# Verificăm ambele variante (boolean sau numeric)
		if $test == true then
			set $if_res = tbasic_exec_line($act)
			return $if_res # OPREȘTE execuția aici pentru a evita dublarea
		endif
		
		#if $test == 1 then
		#	set $void = tbasic_exec_line($act)
		#	return 1 # OPREȘTE execuția aici
		#endif
		
		return 1
	endif
	
	
	#echo "INAINTE DE GOTO"
	if $p_cmd == "GOTO" then
		#echo "Sunt in GOTO"
		set $tb_jump_to = INT($p_parts[1])
		return 1
	endif
	
	# --- COMANDA GOSUB ---
    if $p_cmd == "GOSUB" then
		# Folosim @pc pentru a accesa contorul din funcția run
		$void = PUSH($tb_gosub_stack, @pc) 
		set $tb_jump_to = INT($p_parts[1])
		return 1
	endif
	
	# --- COMANDA RETURN ---
    if $p_cmd == "RETURN" then
        if LEN($tb_gosub_stack) == 0 then
            echo "RUNTIME ERROR: RETURN without GOSUB"
            return -1
        endif
        
        # Scoatem ultimul PC salvat
        set $return_pc = POP($tb_gosub_stack)
        
        # Setăm PC-ul în tbasic_run la poziția de după GOSUB
        # Deoarece tbasic_run va face $pc = $pc + 1 la finalul buclei, 
        # setăm direct indexul recuperat.
        set @pc = $return_pc 
        return 1
    endif
	
	
	if $p_cmd == "PRINT" then
		set $p_args = TRIM(SUBSTR($l_c, 6))
		
		# Cazul PRINT simplu (doar newline)
		if $p_args == "" then
			echo ""
			return 1
		endif

		# Detectăm dacă avem separator la final (; sau ,)
		set $last_char = SUBSTR($p_args, LEN($p_args) - 1, 1)
		set $has_trailing = false
		if $last_char == ";" || $last_char == "," then
			set $has_trailing = true
		endif

		set $current_part = ""
		set $in_q = false
		
		for $i = 0 to LEN($p_args) - 1 do
			set $char = SUBSTR($p_args, $i, 1)
			
			if ASC($char) == 34 then # Ghilimele (ASCII 34)
				set $in_q = NOT($in_q)
				set $current_part = $current_part + $char
			else 
				if ($char == "," || $char == ";") && $in_q == false then
				# Am ajuns la un separator, scriem ce am adunat
					if TRIM($current_part) != "" then
						set $val = tbasic_parse_expr($current_part)
						set $void = WRITE(STR($val)) # Folosim WRITE nativ
					endif
				
					# Gestionăm spațierea (virgula adaugă tab/spații)
					if $char == "," then 
						set $void = WRITE("    ") 
					endif
				
					set $current_part = ""
				else
					set $current_part = $current_part + $char
				endif
			endif
		endfor

		# Scriem și ultima parte rămasă
		if TRIM($current_part) != "" then
			set $val = tbasic_parse_expr($current_part)
			set $void = WRITE(STR($val))
		endif

		# DACĂ nu avem separator la final, dăm un rând nou
		if $has_trailing == false then
			echo "" 
		endif
		
		return 1
	endif
	
	# --- DEFINIM VARIABILA DE VERIFICARE ---
	if $p_cmd == "INPUT" then
		set $c_pos = FIND($l_c, ",")
		if $c_pos == -1 then return 0 endif

		# Căutăm prima ghilimele
		set $start_q = FIND($l_c, CHR(34))
		
		# Pentru a găsi a doua ghilimele fără FIND_LAST:
		# Luăm restul string-ului de după prima ghilimele
		set $rest_of_line = SUBSTR($l_c, $start_q + 1)
		set $end_q_relative = FIND($rest_of_line, CHR(34))
		
		# Extragem mesajul
		set $msg = SUBSTR($rest_of_line, 0, $end_q_relative)

		# Variabila de după virgulă
		set $var_raw = TRIM(SUBSTR($l_c, $c_pos + 1))
		
		set $res = INPUT($msg)
		
		set $v_idx = ASC(UPPER($var_raw)) - 65
		set @tb_vars[INT($v_idx)] = INT($res)
		
		return 1
	endif
	
	if $p_cmd == "END" then
		return -1
	endif
	
	if $p_cmd == "REM" then
		return 1
	endif
	
	if $p_cmd == "CLS" then
		cls
		return 1
	endif
	
	if $p_cmd == "TEST" then
		test()
		return 1
	endif
	
	if SUBSTR($up_in, 0, 4) == "SAVE" then
		set $filename = TRIM(SUBSTR($input, 5))
		# Curățăm ghilimelele dacă utilizatorul a scris SAVE "program.bas"
		set $filename = REPLACE($filename, CHR(34), "")
		
		if $filename == "" then set $filename = "program.bas" endif
		
		set $k = KEYS($tb_program)
		set $k = SORT_NUMERIC_ARRAY($k)
		
		set $file_content = ""
		for $idx = 0 to LEN($k)-1 do 
			set $line_num = $k[$idx]
			set $line_text = $tb_program[$line_num]
			# Construim linia: "10 PRINT A" + Newline
			set $file_content = $file_content + STR($line_num) + " " + $line_text + CHR(10)
		endfor
		
		# Apelăm funcția ta nativă din C++
		set $res = WRITEFILE($filename, $file_content)
		
		if $res == 1 then
			echo "Program salvat cu succes in: " + $filename
		else
			echo "EROARE la salvarea fisierului!"
		endif
		continue
	endif

	if SUBSTR($up_in, 0, 4) == "LOAD" then
		set $filename = TRIM(SUBSTR($input, 5))
		set $filename = REPLACE($filename, CHR(34), "")
		
		if $filename == "" then set $filename = "program.bas" endif
		
		# Citim tot conținutul prin funcția ta C++
		set $raw_content = READFILE($filename)
		
		if $raw_content == null then
			echo "Eroare: Fisierul " + $filename + " nu exista!"
			return 1
		endif
		
		# Resetăm programul curent
		set $tb_program = MAP()
		
		# Spargem conținutul în linii (presupunând că ai un SPLIT după \n)
		set $lines = SPLIT($raw_content, CHR(10))
		
		cycle $lines as $single_line do
			set $trimmed = TRIM($single_line)
			if $trimmed != "" then
				set $parts = TB_SPLIT($trimmed)
				set $ln = INT($parts[0])
				if $ln > 0 then
					# Extragem restul liniei de după numărul liniei
					set $content = TRIM(SUBSTR($trimmed, LEN($parts[0])))
					set $tb_program[$ln] = $content
				endif
			endif
		endcycle
		
		echo "Incarcat " + LEN($tb_program) + " linii din " + $filename
		continue
	endif
	
endfunc

func tbasic_run
    set $keys = KEYS($tb_program)
	#dm
	#trace
    #SORT($keys)
	set $keys = SORT_NUMERIC_ARRAY($keys)
    set $pc = 0
    set $tb_jump_to = -1
    #echo "[Oli-BASIC Running...]"
    
    while $pc < LEN($keys) do
        # Debug: sa vedem ce e in keys la pozitia curenta
        # #echo "PC:" + $pc + " LINE:" + $keys[$pc]
        
        #tbasic_exec_line($tb_program[$keys[$pc]])
		set $res = tbasic_exec_line($tb_program[$keys[$pc]])
        
		if $res == -1 then
            set $tb_running = false
            break
        endif
		
        if $tb_jump_to != -1 then
            # REPARAȚIE: Forțăm căutarea să fie compatibilă (String vs String)
            set $target = STR($tb_jump_to) 
            set $tb_jump_to = -1
            
            # Căutăm în array-ul de chei convertit sau direct
            set $new_pc = INDEXOF($keys, $target)
            
            # Dacă INDEXOF tot nu merge, facem o căutare manuală (brute force)
            if $new_pc == -1 then
                for $find_idx = 0 to LEN($keys)-1 do
                    if STR($keys[$find_idx]) == $target then
                        set $new_pc = $find_idx
                        break
                    endif
                endfor
            endif

            if $new_pc != -1 then
                set $pc = $new_pc
                continue # Sari direct la iterația următoare cu noul PC
            else
                #echo "ERROR: Line " + $target + " not found in " + STR($keys)
                break
            endif
        endif
        
        set $pc = $pc + 1
    endwhile
    #echo "[Done]"
endfunc

# --- MONITORUL INTERACTIV ---
#set $running = 1
#echo "Oli-BASIC v1.9 - Ready (Stable IF)"
#while $running == 1 do
while true do
	set $input = TRIM(INPUT("BASIC> "))
	if $input == "" then 
		continue 
	endif
	set $up_in = UPPER($input)
	if $up_in == "EXIT" then 
		break 
	endif
	if $up_in == "RUN" then 
		tbasic_run()
		continue 
	endif
	if $up_in == "LIST" then
		set $k = KEYS($tb_program)
		#SORT($k)
		SORT_NUMERIC_ARRAY($k)
		for $j = 0 to LEN($k)-1 do 
			# Extragem numarul liniei si continutul
			echo STR($k[$j]) + " " + $tb_program[$k[$j]] 
		endfor
		continue
	endif
	if $up_in == "NEW" then
		set $tb_program = MAP(); 
		for $v = 0 to 25 do 
			set $tb_vars[$v] = 0 
		endfor; 
			#echo "Memory Cleared."; 
			continue
	endif
	set $parts = TB_SPLIT($input)
	set $line_no = INT($parts[0])
	if $line_no > 0 then
		set $tb_program[INT($line_no)] = TRIM(SUBSTR($input, LEN($parts[0])))
	else
		set $void = tbasic_exec_line($input)
	endif
endwhile
# Makefile.plugin.common
CXX = g++
CXXFLAGS += -std=c++20 -Wall -Wextra -O3 -fPIC -I../../../include -I../../../include

ifeq ($(OS),Windows_NT)
LDFLAGS += -shared -static -static-libgcc -static-libstdc++
TARGET = ../../../$(PLUGIN_NAME).dll
else
TARGET = ../../../$(PLUGIN_NAME).so
endif


# Numele pluginului este determinat de numele directorului curent
PLUGIN_NAME = $(notdir $(CURDIR))


SRCS = $(wildcard *.cpp)
OBJS = $(SRCS:.cpp=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)
	cp $(TARGET) ../../../plugins
%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f *.o $(TARGET)

.PHONY: all clean

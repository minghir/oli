config win_app 1
plugin oli_system
plugin "oli_xui"

include ("include/xui.oli")

func pe_apasare_buton()
    echo "[VM OLI] Semnal primit cu succes din GTK!"
    SHOW_MESSAGE("XUI Test", "Conexiunea C++ <-> Script Oli funcționează perfect în GTK!")
endfunc

# Funcție pentru meniul exit
func meniu_exit()
    echo "Ieșire din aplicație..."
    exit()
endfunc

echo "--- Pornire Test Direct (GTK + Meniu) ---"

set $app = new("XApp")
$app.init()

set $win = new("XWindow")
$win.init("fereastra_principala", "Test Direct GTK cu Meniu")

# 1. CREARE MENIU
set $meniu = new("XMenu")
$meniu.init("main_menu", "fereastra_principala")
$meniu.add_item("item_exit", "Exit")
$meniu.bind("click", "meniu_exit") # Legăm acțiunea de click

# 2. BUTON
set $buton = new("XButton")
$buton.init("btn_salut", "fereastra_principala", 50, 50, 200, 50, "Apasă-mă! 🚀")
$buton.bind("click", "pe_apasare_buton")

$win.show()
$app.run()

echo "--- Aplicație Oprită ---"
unset all
func COUNT_ARR arr_to_count
set $i=0
  cycle $arr_to_count as val do 
	set $i = $i + 1 
	endcycle
  return $i
endfunc


proc sort array
set $arr = $array 
set $i=0 
set $j=0 
set $n = COUNT_ARR($arr) 
while $i < $n do 
   set $j = $i + 1 
   while $j < $n do 
           if $arr[$i] > $arr[$j] then 
                   echo  "Am comparat :" + $arr[$i] +" cu: "+ $arr[$j] 
                   set $temp = $arr[$i] 
                   set $arr[$i] = $arr[$j] 
                   set $arr[$j] = $temp 
           endif 
           set $j = $j + 1 
   endwhile 
   set $i = $i + 1 
 endwhile 
 cycle $arr as val do echo $val endcycle 
 endproc
 
 
func SORT_FN array
set $arr = $array 
set $i=0 
set $j=0 
set $n = COUNT_ARR($arr) 
while $i < $n do 
   set $j = $i + 1 
   while $j < $n do 
           if $arr[$i] > $arr[$j] then 
                   #echo  "Am comparat :" + $arr[$i] +" cu: "+ $arr[$j] 
                   set $temp = $arr[$i] 
                   set $arr[$i] = $arr[$j] 
                   set $arr[$j] = $temp 
           endif 
           set $j = $j + 1 
   endwhile 
   set $i = $i + 1 
 endwhile 
 #cycle $arr as val do echo $val endcycle 
 return $arr
 endfunc
 
set $numbers=[4,2,77,3,1,65,44,100,31,99,72,2378]
 #sort numbers
 #dm
 set $numbers2=[14,22,717,3,1,65,4,10,3,99,72,2378]
 set $arr_test = SORT_FN($numbers)
 echo "Print sortare cu functie"
cycle $arr_test as val do echo $val endcycle 
 
 
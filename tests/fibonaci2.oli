set @memo = ARRAY(93)
set @memo[0] = 0
set @memo[1] = 1

func fib_memo($n)
    if @memo[$n] != NULL then
        return @memo[$n]
    endif
    
    set $res = fib_memo($n - 1) + fib_memo($n - 2)
    set @memo[$n] = $res
    return $res
endfunc

# Schimbăm de la $i = 0
for $i = 0 to 92 do
    echo fib_memo($i)
endfor
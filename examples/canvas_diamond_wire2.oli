# --- SETUP ---
config echo off
config max_iterations 0

plugin oli_canvas
plugin oli_math
plugin oli_keyboard
plugin oli_time

func RENDER_DIAMOND_SOLID()
    set $W = 800; set $H = 800
    set $v = CAN_INIT($W, $H, "Oli Engine - Solid Diamond Rendering")
    
    # --- DATE DIAMANT ---
    # Alocăm array-urile necesare pentru 6 puncte (0-5)
    set $vx = array(6); set $vy = array(6); set $vz = array(6)
    set $sx = array(6); set $sy = array(6)

    # Definire Vârfuri: 0 (sus), 1 (jos), 2-5 (inelul median)
    set $vx[0]=0;    set $vy[0]=-2;  set $vz[0]=0
    set $vx[1]=0;    set $vy[1]= 2;  set $vz[1]=0
    set $vx[2]=-1.5; set $vy[2]=0;   set $vz[2]=-1.5
    set $vx[3]= 1.5; set $vy[3]=0;   set $vz[3]=-1.5
    set $vx[4]= 1.5; set $vy[4]=0;   set $vz[4]= 1.5
    set $vx[5]=-1.5; set $vy[5]=0;   set $vz[5]= 1.5

    # --- DEFINIRE FEȚE ---
    # Cele 8 triunghiuri ale diamantului (Piramida sus + Piramida jos)
    # Ordinea vârfurilor este crucială pentru Backface Culling
    set $faces = [  [0, 2, 3], [0, 3, 4], [0, 4, 5], [0, 5, 2],  [1, 3, 2], [1, 4, 3], [1, 5, 4], [1, 2, 5]  ]

	

    set $oldTime = TIME()
    set $smoothFps = 0.0
    set $colorMagenta = 16711935
    set $colorCyan = 65535

    while true do
        set $currentTime = TIME()
        set $deltaTime = $currentTime - $oldTime
        set $oldTime = $currentTime

        if $deltaTime > 0 then
            set $currentFps = 1.0 / $deltaTime
            set $frameCount = $frameCount + 1.0
            set $smoothFps = LERP($smoothFps, $currentFps, 0.05)
        endif

        set $v = CAN_CLS(0)
        
        # Efect Morphing între culori folosind LERP
        set $factor = (SIN($currentTime * 0.4) + 1.0) / 2.0
        set $currentColor = LERP($colorMagenta, $colorCyan, $factor)

        set $t = $currentTime * 30

        # --- 1. PROIECȚIE 3D -> 2D ---
        for $i = 0 to 5 do
            set $x = $vx[$i]; set $y = $vy[$i]; set $z = $vz[$i]
            
            set $x1 = $x * COS($t) + $z * SIN($t)
            set $z1 = -1.0 * $x * SIN($t) + $z * COS($t)
            set $y2 = $y * COS($t * 0.5) - $z1 * SIN($t * 0.5)
            set $z2 = $y * SIN($t * 0.5) + $z1 * COS($t * 0.5)
            
            set $f = 450.0 / ($z2 + 7.0)
            set $sx[$i] = ($x1 * $f) + 400
            set $sy[$i] = ($y2 * $f) + 400
        endfor

        # --- 2. DESENARE FEȚE (TRIUNGHIURI) ---
        for $f_idx = 0 to 7 do
            set $face = $faces[$f_idx]
            set $v1 = $face[0]; set $v2 = $face[1]; set $v3 = $face[2]
            
            # Backface Culling: Calculăm Cross Product-ul în 2D
            # $$cp = (x_2 - x_1)(y_3 - y_1) - (y_2 - y_1)(x_3 - x_1)$$
            set $cp = ($sx[$v2] - $sx[$v1]) * ($sy[$v3] - $sy[$v1]) - ($sy[$v2] - $sy[$v1]) * ($sx[$v3] - $sx[$v1])
            
            # Desenăm doar dacă fața este orientată spre cameră (cp > 0)
            if $cp > 0 then
                # Flat Shading rudimentar bazat pe indexul feței
                set $shade = $f_idx * 1500
                set $v = CAN_TRIANGLE($sx[$v1], $sy[$v1], $sx[$v2], $sy[$v2], $sx[$v3], $sy[$v3], $currentColor - $shade)
            endif
        endfor

        if $frameCount > 10 then
            set $v = CAN_PUT_TXT(10, 10, "FPS: " + STR(INT($smoothFps)))
            set $v = CAN_PUT_TXT(10, 25, "Mode: Solid Rendering")
        endif

        set $v = CAN_PRESENT()
        if KEY_STATE(81) == 1 then break endif
    endwhile
endfunc

set $res = RENDER_DIAMOND_SOLID()
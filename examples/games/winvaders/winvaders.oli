# --- OPTIMIZARE ---
config echo off
config max_iterations 0

# --- SETUP ---
plugin oli_canvas
plugin oli_math
plugin oli_keyboard
plugin oli_fract
plugin oli_time
plugin oli_sprites

set $SW = 800
set $SH = 600
set $v = CAN_INIT($SW, $SH, "Oli Engine - Starfield Invaders")
set $ptr = CAN_GET_PTR()
set $ship_size = 40
set $VPW = $SW - $ship_size
set $VPH = $SH - $ship_size

# 1. Pregătire Navă
set $myShip = SPRITE_LOAD("./examples/games/winvaders/ship.png") 
SPRITE_SIZE($myShip, $ship_size, $ship_size)

# 2. Inițializare Sistem Stele (Parallax)
set $numStars = 80
set $starX = array($numStars)      # REPARAT
set $starY = array($numStars)      # REPARAT
set $starSpeed = array($numStars)  # REPARAT

for $i = 0 to $numStars - 1 do
    set $starX[$i] = RANDOM(0, $SW)
    set $starY[$i] = RANDOM(0, $SH)
    set $starSpeed[$i] = RANDOM(1, 4) # Viteze diferite pentru adâncime
endfor

set $x = 300
set $y = 350

# 2.5 Inițializare Gloanțe (Max 10 pe ecran simultan)
set $maxBullets = 1
set $bX = array($maxBullets)       # REPARAT
set $bY = array($maxBullets)       # REPARAT
set $bActive = array($maxBullets)  # REPARAT
set $bulletSpeed = 12

for $i = 0 to $maxBullets - 1 do
    set $bActive[$i] = 0
endfor

# Timer pentru a nu trage prea repede (cooldown)
set $lastShot = 0



# 2.6 Pregătire Inamici
set $enemyShip = SPRITE_LOAD("./examples/games/winvaders/small_e.png") 
set $eSize = 30
SPRITE_SIZE($enemyShip, $eSize, $eSize)

set $numEnemies = 8
set $eX = array($numEnemies)       # REPARAT
set $eY = array($numEnemies)       # REPARAT
set $eAlive = array($numEnemies)   # REPARAT
set $eSpeed = 2
set $eDirection = 1 # 1 = dreapta, -1 = stânga

for $i = 0 to $numEnemies - 1 do
    set $eX[$i] = $i * 70 + 50
    set $eY[$i] = 50
    set $eAlive[$i] = 1
endfor


# 2.7 Inițializare Gloanțe Inamici
set $maxEBullets = 5
set $ebX = array($maxEBullets)
set $ebY = array($maxEBullets)
set $ebActive = array($maxEBullets)
set $eBulletSpeed = 5

for $i = 0 to $maxEBullets - 1 do
    set $ebActive[$i] = 0
endfor

set $oldTime = TIME()
set $smoothFps = 60.0  # Începem cu o valoare estimată
set $frameCount = 0

while true do

	# 1. Calcul Delta Time
    set $currentTime = TIME()
    set $dt = $currentTime - $oldTime
    set $oldTime = $currentTime

    # 2. Calcul FPS și Netezire cu LERP
    if $dt > 0 then
        set $instantFps = 1.0 / $dt
        
        # Folosim LERP: 
        # LERP(valoare_curentă, valoare_nouă, factor_de_netezire)
        # Un factor de 0.05 înseamnă că "adoptăm" 5% din noua valoare la fiecare cadru
        set $smoothFps = LERP($smoothFps, $instantFps, 0.05)
    endif

    # Ștergem buffer-ul
    CAN_CLS(0)

    # --- 3. LOGICĂ ȘI DESENARE STELE ---
    for $i = 0 to $numStars - 1 do
        # Mișcare picătură/stea
        set $starY[$i] = $starY[$i] + $starSpeed[$i]

        # Resetare dacă a ieșit din ecran
        if $starY[$i] > $SH then
            set $starY[$i] = 0
            set $starX[$i] = RANDOM(0, $SW)
        endif

        # Calcul culoare bazat pe viteză (gri închis -> alb)
        # Formula: (R << 16) + (G << 8) + B
        set $bright = $starSpeed[$i] * 63
        set $color = ($bright * 65536) + ($bright * 256) + $bright
        
        CAN_PUT($starX[$i], $starY[$i], $color)
    endfor

    # --- 4. LOGICĂ ȘI DESENARE GLOANȚE (Neon Glow Edition - REPARAT) ---
		# --- 4. LOGICĂ ȘI DESENARE GLOANȚE (Neon Blue Trail) ---
		for $i = 0 to $maxBullets - 1 do
			if $bActive[$i] == 1 then
				set $bY[$i] = $bY[$i] - $bulletSpeed
				
				set $lx = $bX[$i]
				set $ly = $bY[$i]

				# 1. Urma (Trail) - Mai lungă și mai închisă la culoare
				# 13158 (un albastru închis/navy)
				CAN_RECT($lx, $ly + 10, 2, 15, 13158)

				# 2. Corpul secundar (Glow-ul urmei)
				# 33023 (un albastru mediu/sky blue)
				CAN_RECT($lx, $ly + 5, 2, 10, 33023)

				# 3. Vârful Laserului (Capătul activ - cel mai strălucitor)
				# 65535 (Cyan/Albastru electric)
				CAN_RECT($lx, $ly, 2, 8, 65535)

				# Dezactivăm dacă iese din ecran
				if $bY[$i] < -30 then
					set $bActive[$i] = 0
				endif
			endif
		endfor	
		
		# --- 4.2 LOGICĂ GLOANȚE INAMICI (Yellow Tail Edition) ---
		# --- 4.2 LOGICĂ GLOANȚE INAMICI (Short & Fast Trail) ---
for $i = 0 to $maxEBullets - 1 do
    if $ebActive[$i] == 1 then
        set $ebY[$i] = $ebY[$i] + $eBulletSpeed
        
        set $ex_l = $ebX[$i]
        set $ey_l = $ebY[$i]

        # 1. Urma (Coada foarte scurtă - Galben închis)
        # O punem imediat după corpul secundar
        CAN_RECT($ex_l, $ey_l - 10, 2, 4, 16750848)

        # 2. Corpul secundar (Galben intens)
        # Îl lipim de vârful roșu
        CAN_RECT($ex_l, $ey_l - 6, 2, 6, 16776960)

        # 3. Vârful Laserului (Roșu - punctul de impact)
        # Lungime de doar 6 pixeli
        CAN_RECT($ex_l, $ey_l, 3, 6, 16711680)

        # --- Coliziune cu Jucătorul ---
        if $ex_l > $x then
            if $ex_l < ($x + $ship_size) then
                if $ey_l > $y then
                    if $ey_l < ($y + $ship_size) then
                        CAN_CLS(16711680) 
                        CAN_PRESENT()
                        SLEEP(100)
                        set $x = 300
                        set $y = 350
                        set $ebActive[$i] = 0
                    endif
                endif
            endif
        endif

        # Dezactivăm dacă a ieșit din ecran
        if $ey_l > ($SH + 10) then 
            set $ebActive[$i] = 0 
        endif
    endif
endfor
	
    # --- 5. DESENARE NAVĂ ---
    SPRITE_DRAW($ptr, $SW, $SH, $myShip, $x, $y)

    
    
    # --- 6. LOGICĂ DE MIȘCARE ȘI TRAGERE ---
    if KEY_STATE(37) == 1 then set $x = $x - 5 endif
    if KEY_STATE(39) == 1 then set $x = $x + 5 endif
    if KEY_STATE(38) == 1 then set $y = $y - 5 endif
    if KEY_STATE(40) == 1 then set $y = $y + 5 endif
	
    # Tragere cu SPACE (32)
    if KEY_STATE(32) == 1 then
        # Verificăm cooldown-ul folosind TIME() (ex: un glonț la 200ms)
        set $now = TIME() * 1000
        if ($now - $lastShot) > 200 then
            # Căutăm un slot de glonț liber
            for $i = 0 to $maxBullets - 1 do
                if $bActive[$i] == 0 then
                    set $bActive[$i] = 1
                    # Poziționăm glonțul în centrul navei
                    set $bX[$i] = $x + ($ship_size / 2)
                    set $bY[$i] = $y
                    set $lastShot = $now
                    break # Ieșim din for după ce am tras un glonț
                endif
            endfor
        endif
    endif
	
	# --- 4.5 LOGICĂ ȘI DESENARE INAMICI ---
    set $bumpWall = 0
    for $i = 0 to $numEnemies - 1 do
        if $eAlive[$i] == 1 then
		
			# Șansă mică să tragă la fiecare cadru (ex: 1 la 200)
			if RANDOM(0, 200) == 7 then
				for $k = 0 to $maxEBullets - 1 do
					if $ebActive[$k] == 0 then
						set $ebActive[$k] = 1
						set $ebX[$k] = $eX[$i] + ($eSize / 2)
						set $ebY[$k] = $eY[$i] + $eSize
						break
					endif
				endfor
			endif
		
            # Mișcare orizontală
            set $eX[$i] = $eX[$i] + ($eSpeed * $eDirection)
            
            # Verificăm dacă ating marginea ecranului
            if $eX[$i] > ($SW - $eSize) then set $bumpWall = 1 endif
            if $eX[$i] < 0 then set $bumpWall = 1 endif

            # Desenare
            SPRITE_DRAW($ptr, $SW, $SH, $enemyShip, $eX[$i], $eY[$i])

            # --- 4.6 COLIZIUNE CU GLOANȚELE ---
            for $j = 0 to $maxBullets - 1 do
                if $bActive[$j] == 1 then
                    # Verificăm dacă glonțul J este în interiorul inamicului I
                    # Folosim o verificare de tip box-collision simplificată
                    if $bX[$j] > $eX[$i] then
                        if $bX[$j] < ($eX[$i] + $eSize) then
                            if $bY[$j] > $eY[$i] then
                                if $bY[$j] < ($eY[$i] + $eSize) then
                                    set $eAlive[$i] = 0   # Inamic mort
                                    set $bActive[$j] = 0 # Glonț consumat
                                endif
                            endif
                        endif
                    endif
                endif
            endfor
        endif
    endfor

    # Dacă un inamic a atins peretele, toți coboară un nivel și schimbă direcția
    if $bumpWall == 1 then
        set $eDirection = $eDirection * -1
        for $k = 0 to $numEnemies - 1 do
            set $eY[$k] = $eY[$k] + 20
        endfor
    endif

	CAN_PUT_TXT(10, 10, "FPS: " + STR(INT($smoothFps)))
	
	CAN_PRESENT()
	
    # Limite ecran (neschimbat)
    if $x < 0 then set $x = 0 endif
    if $x > $VPW then set $x = $VPW endif
    if $y < 0 then set $y = 0 endif
    if $y > $VPH then set $y = $VPH endif

    SLEEP(12)
    if KEY_STATE(81) == 1 then break endif
endwhile

CAN_CLOSE()
plugin oli_time

set @cache = {}

func mack($m, $n)
    $key = $m .. "," .. $n
    
    if @cache[$key] != NULL then
        return @cache[$key]
    endif

    $res = 0
    if $m == 0 then 
        $res = $n + 1
    else 
        if $n == 0 then
            $res = mack($m - 1, 1)
        else
            $res = mack($m - 1, mack($m, $n - 1))
        endif
    endif

    set @cache[$key] = $res
    return $res
endfunc

for $i = 0 to 32765 do
    $dummy = mack(2, $i)
endfor

for $i = 0 to 13 do
    $dummy = mack(3, $i)
endfor

echo mack(4, 1)
input()
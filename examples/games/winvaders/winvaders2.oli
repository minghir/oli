# --- CONFIGURARE ---
config echo off
config max_iterations 0

plugin oli_opengl
plugin oli_keyboard
plugin oli_math

# --- 1. IERARHIA DE CLASE ---

# Clasa de bază pentru tot ce are coordonate și imagine
def class Entity { x, y, active, tex, w, h }

# Gloanțele: simple, galbene (sau poți pune și aici textură)
def class Bullet extends Entity { speed, update() }
func Bullet::update()
    if $this.active == 1 then
        set $this.y = $this.y + $this.speed
        if $this.y > 350 then set $this.active = 0 endif
    endif
endfunc

# Inamicul: folosește GL_DRAW_SPRITE
def class Enemy extends Entity { move($d, $s), draw() }
func Enemy::move($d, $s)
    set $this.x = $this.x + ($s * $d)
endfunc

func Enemy::draw()
    # GL_DRAW_SPRITE(id, x, y, w, h, rot)
    GL_DRAW_SPRITE($this.tex, $this.x, $this.y, $this.w, $this.h, 0)
endfunc

# Boss-ul: moștenește Enemy, dar e mai mare și se rotește (pentru efect)
def class Boss extends Enemy { angle, draw() }
func Boss::draw()
    set $this.angle = $this.angle + 2 # Rotație continuă
    GL_DRAW_SPRITE($this.tex, $this.x, $this.y, $this.w, $this.h, $this.angle)
endfunc

# --- 2. INIȚIALIZARE JOC ---

GL_INIT(800, 600, "Oli Invaders - Hardware Accelerated")
GL_SET_VSYNC(1) # Forțează jocul să ruleze la 60 FPS

# Încărcăm texturile (O singură dată!)
set $texPlayer = GL_LOAD_TEXTURE("./examples/games/winvaders/ship.png")
set $texEnemy  = GL_LOAD_TEXTURE("./examples/games/winvaders/small_e.png")
set $texBoss   = GL_LOAD_TEXTURE("./examples/games/winvaders/boss.png") # Presupunem că ai un boss.png

# Inițializare Jucător
set $px = 0
set $py = -250

# Creăm armata de inamici
set $numE = 6
set $enemies = array($numE)
for $i = 0 to $numE - 1 do
    if $i == 3 then
        set $enemies[$i] = new("Boss")
        $enemies[$i].tex = $texBoss
        $enemies[$i].w = 80
        $enemies[$i].h = 80
    else
        set $enemies[$i] = new("Enemy")
        $enemies[$i].tex = $texEnemy
        $enemies[$i].w = 40
        $enemies[$i].h = 40
    endif
    set $enemies[$i].x = ($i * 100) - 250
    set $enemies[$i].y = 200
    set $enemies[$i].active = 1
endfor

# Rezervăm sloturi pentru gloanțe
set $maxB = 5
set $bullets = array($maxB)
for $i = 0 to $maxB - 1 do
    set $bullets[$i] = new("Bullet")
    $bullets[$i].active = 0
    $bullets[$i].speed = 12
endfor

set $eDir = 1


set $eSpeed = 0.5   # Inamicii se mișcă mult mai fin
set $pSpeed = 4.0   # Viteza jucătorului ajustată
set $bulletSpeed = 8.0

# --- 3. LOOP PRINCIPAL ---

while true do
    GL_CLEAR(0x050510) # Fundal spațial închis

	# Aflăm limitele ferestrei în acest moment
    set $limitX = (GL_WIDTH() / 2) - ($shipW / 2)
    set $limitY = (GL_HEIGHT() / 2) - ($shipW / 2) # Opțional, dacă vrei limită și pe verticală

    # A. Control Jucător
    if KEY_STATE(37) == 1 then set $px = $px - 7 endif
    if KEY_STATE(39) == 1 then set $px = $px + 7 endif
    
	
	# Limitare Dinamică
    if $px < -$limitX then set $px = -$limitX endif
    if $px > $limitX  then set $px = $limitX endif
	
    # Desenăm nava jucătorului cu textură
    GL_DRAW_SPRITE($texPlayer, $px, $py, 50, 50, 0)

    # B. Tragere (Space)
    if KEY_STATE(32) == 1 then
        for $i = 0 to $maxB - 1 do
            if $bullets[$i].active == 0 then
                set $bullets[$i].active = 1
                set $bullets[$i].x = $px
                set $bullets[$i].y = $py + 20
                break
            endif
        endfor
    endif

    # C. Update & Desenare Gloanțe
    cycle $bullets as $b do
        if $b.active == 1 then
            $b.update()
            # Glonțul poate rămâne un punct luminos sau îi poți pune o mică textură de laser
            GL_POINT($b.x, $b.y, 8, 0x00FFFF) 
        endif
    endcycle

    # D. Update & Desenare Inamici (Polimorfism pur)
    set $edge = 0
    cycle $enemies as $en do
        if $en.active == 1 then
            $en.move($eDir, $eSpeed)
            $en.draw()

            if $en.x > 360 || $en.x < -360 then set $edge = 1 endif

            # Verificare Coliziune (Glonț -> Inamic)
            cycle $bullets as $blt do
                if $blt.active == 1 then
                    # Hitbox dinamic bazat pe dimensiunea sprite-ului
                    if ABS($blt.x - $en.x) < ($en.w / 2) then
                        if ABS($blt.y - $en.y) < ($en.h / 2) then
                            set $en.active = 0
                            set $blt.active = 0
                        endif
                    endif
                endif
            endcycle
        endif
    endcycle

    # E. Logică de coborâre a inamicilor
    if $edge == 1 then
        set $eDir = $eDir * -1
        cycle $enemies as $e2 do 
            set $e2.y = $e2.y - 20 
        endcycle
    endif


# --- BONUS: UI care se mișcă cu fereastra ---
    # Putem pune scorul mereu în colțul din stânga sus, indiferent de mărime
    set $textX = -(GL_WIDTH() / 2) + 20
    set $textY = (GL_HEIGHT() / 2) - 20
    GL_TEXT($textX, $textY, "REZOLUTIE: " + STR(GL_WIDTH()) + "x" + STR(GL_HEIGHT()))



    GL_PRESENT()
    if KEY_STATE(27) == 1 then break endif
endwhile

GL_CLOSE()
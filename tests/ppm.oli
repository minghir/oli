# 1. Configurare dimensiuni
set $w = 800
set $h = 800
set $pixelCount = $w * $h
set $data = array(1 + ($pixelCount * 3))

# 2. Header curat (fara \r)
set $data[0] = "P6 ".. $w .." ".. $h .." 255" .. char(10)

# 3. Dimensiunea patratului
set $size = 32

for $y = 0 to $h - 1 do
    for $x = 0 to $w - 1 do
        set $idx = 1 + (($y * $w + $x) * 3)
        
        # Calculam coordonatele grilei (folosind $y cu simbol)
        set $gx = floor($x / $size)
        set $gy = floor($y / $size)
        
        if (($gx + $gy) % 2) == 0 then
            set $data[$idx]     = 255      
            set $data[$idx + 1] = 0       
            set $data[$idx + 2] = 0
        else
            set $data[$idx]     = 0        
            set $data[$idx + 1] = 0        
            set $data[$idx + 2] = 0     
        endif
    endfor
endfor

writefile("chessboard_final.ppm", $data)
echo "Imagine generata fara artefacte!"
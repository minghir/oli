plugin oli_threads

func consumator_cu_timeout()
    echo "Consumatorul asteapta un mesaj maxim 500ms..."
    
    # Așteptăm maxim 500ms pe o coadă în care nu postează nimeni
    $msg = QUEUE_POP_TIMEOUT("jobs_lipsa", 500)
    
    if STR($msg) == "" do
        echo "LOG: A intervenit TIMEOUT! Niciun mesaj primit in 500ms."
        return 0
    endif

    return 1
endfunc

echo "=== TEST QUEUE POP TIMEOUT ==="

$t1 = THREAD_SPAWN("consumator_cu_timeout")
THREAD_WAIT($t1)

echo "Test finalizat cu succes!"
<NotepadPlus>
    <UserLang name="Oli" ext="oli" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="no" allowFoldOfComments="no" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00#</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1"></Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            # Operatori standard
            <Keywords name="Operators1">- ! ( ) * , / : ; ? [ ] { } + &lt; = &gt;</Keywords>
            <Keywords name="Operators2">== != &lt;= &gt;= &amp;&amp; ||</Keywords>
            # Code Folding (Restrângere cod)
            <Keywords name="Folders in code1, open">func if while for cycle</Keywords>
            <Keywords name="Folders in code1, middle">else</Keywords>
            <Keywords name="Folders in code1, close">endfunc endif endwhile endfor endcycle</Keywords>
            <Keywords name="Keywords1">then do as to return break continue</Keywords>
            <Keywords name="Keywords2">set plugin config echo max_iterations</Keywords>
            <Keywords name="Keywords3">RANDOM SIN COS TAN SQRT POW ABS MIN MAX ROUND PI E TIME TICKS SLEEP CHR CHAR ASC INT STR</Keywords>
            <Keywords name="Keywords4">CON_SCREEN CON_CLS CURSOR DB_INIT DB_PUT DB_PRESENT KEY_STATE GET_KEY PUSH</Keywords>
            # Prefix pentru variabile ($)
            <Keywords name="Numbers, prefix1">$</Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="000000" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="LINE COMMENTS" fgColor="008000" bgColor="FFFFFF" fontStyle="2" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="0080C0" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="A31515" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS2" fgColor="0000FF" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="KEYWORDS3" fgColor="267F99" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS4" fgColor="AF00DB" bgColor="FFFFFF" fontStyle="0" nesting="0" />
            <WordsStyle name="OPERATORS" fgColor="000000" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="FOLDER IN CODE1" fgColor="A31515" bgColor="FFFFFF" fontStyle="1" nesting="0" />
            <WordsStyle name="DELIMITERS1" fgColor="A31515" bgColor="FFFFFF" fontStyle="0" nesting="0" />
        </Styles>
    </UserLang>
</NotepadPlus>
plugin "oli_time"

# 1. Resetăm mediul
unset all
# 🔥 FIX 1: Pentru a calcula F(100), avem nevoie de indicii 0...100, deci dimensiunea trebuie să fie 101!
set $memo = array(101)

# 2. Definim funcția cu Memoization
func FIBO_MEMO($n)
    if $n <= 1 then 
        return $n 
    endif

    if @memo[$n] != NULL then 
        return @memo[$n] 
    endif

    set $res = FIBO_MEMO($n - 1) + FIBO_MEMO($n - 2)
    set @memo[$n] = $res
    
    return $res
endfunc


# 3. Test de Scoping (Verificăm dacă funcțiile pot scrie în Global)
set $test_global = "Original"
func TEST_SCOPE()
    # 🔥 FIX 2: Folosim '@' pentru a forța scrierea în SCOPE-ul GLOBAL din interiorul funcției
    set @test_global = "Modificat"
endfunc

# --- EXECUȚIE ---

echo "--- Test 1: Scoping ---"
TEST_SCOPE()
echo "Valoare globala dupa apel: " + $test_global
# Acum va afișa corect "Modificat"!

echo ""
echo "--- Test 2: Fibonacci cu Memoization ---"
set $start = TICKS()
set $r = FIBO_MEMO(100)
set $end = TICKS()

set $durata = $end - $start
echo "F(100) = " + $r
echo "Timp: " + $durata + " ms"

echo ""
echo "--- Test 3: Starea Cache-ului ---"
dm 
input()
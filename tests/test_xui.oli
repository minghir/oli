config win_app 1
plugin oli_system
plugin "oli_xui"

# Includem harta noastră minimală
include ("xui.oli")

# Callback-ul care se va executa în mașina virtuală Oli la click
func pe_apasare_buton()
    echo "[VM OLI] Semnal primit cu succes din GTK!"
    SHOW_MESSAGE("XUI Test", "Conexiunea C++ <-> Script Oli funcționează perfect în GTK!")
endfunc

echo "--- Pornire Test Direct ---"

set $app = new("WinApp")
$app.init()

set $win = new("WinWindow")
$win.init("fereastra_principala", "Test Direct GTK (Fără Panel)")

set $buton = new("WinButton")
# ⚡ TRUCUL: Transmitem "fereastra_principala" direct ca părinte!
# Coordonatele 50, 50 și dimensiunea 200x50 vor fi puse pe GtkFixed-ul ferestrei
$buton.init("btn_salut", "fereastra_principala", 50, 50, 200, 50, "Apasă-mă! 🚀")

# Legăm evenimentul
$buton.bind("click", "pe_apasare_buton")

# Afișăm totul
$win.show()

# Pornim bucla GTK
$app.run()

echo "--- Aplicație Oprită ---"
config max_iterations 0
config echo off

plugin oli_opengl
plugin oli_keyboard
plugin oli_math

# Inițializare fereastră
set $v = GL_INIT(800, 600, "Oli Engine - The Singularity")

set $t = 0.0
set $running = 1

while $running == 1 do
    # Fundal "Deep Space" (albastru-indigo extrem de închis)
    set $v = GL_CLEAR(0x020205)
    
    set $t = $t + 0.03
    
    # --- STRATUL 1: "Rețeaua Neuronală Externă" (Linii subțiri) ---
    set $i = 0
    while $i < 20 do
        set $a1 = $i * 0.314 + $t * 0.5
        set $a2 = ($i + 1) * 0.314 + $t * 0.5
        
        # Coordonate strat extern
        set $r_ext = 220 + 15 * SIN($t + $i)
        set $x1 = 400 + $r_ext * COS($a1)
        set $y1 = 300 + $r_ext * SIN($a1)
        set $x2 = 400 + $r_ext * COS($a2)
        set $y2 = 300 + $r_ext * SIN($a2)
        
        # Linii de conexiune între noduri (Cian închis)
        set $v = GL_LINE($x1, $y1, $x2, $y2, 0x004455)
        # Noduri de procesare
        set $v = GL_NODE($x1, $y1, 5, 0x00FFEE)
        
        set $i = $i + 1
    endwhile

    # --- STRATUL 2: "Inelul de Date" (Hexagoane rotative) ---
    set $j = 0
    while $j < 6 do
        set $rot = $j * 1.047 - $t * 1.2 # Rotație inversă
        set $r_in = 120 + 10 * COS($t * 3)
        
        set $px1 = 400 + $r_in * COS($rot)
        set $py1 = 300 + $r_in * SIN($rot)
        set $px2 = 400 + $r_in * COS($rot + 1.047)
        set $py2 = 300 + $r_in * SIN($rot + 1.047)
        
        # Linie de forță (Magenta/Violet)
        set $v = GL_LINE($px1, $py1, $px2, $py2, 0xFF00FF)
        # Noduri energetice
        set $v = GL_NODE($px1, $py1, 10, 0xAA00AA)
        
        set $j = $j + 1
    endwhile

    # --- STRATUL 3: "Nucleul" (Puls Central) ---
    set $core_pulse = 30 + 10 * SIN($t * 5)
    set $v = GL_NODE(400, 300, $core_pulse, 0xFFFFFF) # Alb central
    set $v = GL_NODE(400, 300, $core_pulse + 15, 0xFFBB00) # Aură portocalie

    # --- INPUT ȘI RENDER ---
    set $v = GL_PRESENT()
    
    # 🔥 FIXUL CRITIC: Structură curată pe linii separate pentru input
    if KEY_STATE(27) == 1 then 
        set $running = 0 
    endif
    
    if KEY_STATE(81) == 1 then 
        set $running = 0 
    endif
endwhile

set $v = GL_CLOSE()
unset all; cls
# 1. Definim Blueprints (Modelele de date)
def struct Pozitie {x, y}
def struct Statistici {hp, mp, aparare}
def struct Entitate {nume, stats, poz}

# 2. Funcție utilitară: Calcul Damage
# Logica: Scade apărarea din atac, dar nu sub 0
func CALCUL_DAMAGE($atk,$def_val)
    set $daune = $atk - $def_val
    if $daune < 0 then
        return 0
    endif
    return $daune
endfunc

# 3. Funcția Principală de Luptă
# Demonstrează: Deep Reading, Deep Writing și Dynamic Scope
func ATACA($atacator,$tinta,$daune_baza)
    echo "--- LUPTA INCEPE ---"
    echo $atacator.nume + " loveste pe " + $tinta.nume
    
    # Citire în adâncime (Deep Read)
    set $def_final = $tinta.stats.aparare
    
    # Logica de poziționare (Verificăm dacă e în zona de scut)
    if $tinta.poz.x > 100 then
        echo "Sistem: Bonus de scut activat pentru tinta!"
        set $def_final = $def_final + 20
    endif

    # Apel de funcție internă
    set $final_dmg = CALCUL_DAMAGE($daune_baza, $def_final)
    
    # MODIFICARE ÎN ADÂNCIME (Deep Write/Update)
    # Aici intervine mecanismul tău de updateRootSource
    set $tinta.stats.hp = $tinta.stats.hp - $final_dmg
    
    echo "Sistem: Daune calculate: " + $final_dmg
    echo "Sistem: HP curent " + $tinta.nume + ": " + $tinta.stats.hp
    
    return $tinta
endfunc

# --- SECTIUNEA DE TEST ---

# Creăm instanțele (Observă structurile imbricate)
set $erou = Entitate("Galahad", Statistici(100, 50, 10), Pozitie(10, 10))
set $boss = Entitate("Dragon", Statistici(500, 200, 30), Pozitie(150, 50))

# Rulăm atacul
# Dragonul este la X=150, deci scutul se activează (Def: 30 + 20 = 50)
# Atac de 80 - Def 50 = 30 Daune. HP Final: 500 - 30 = 470.
set $boss = ATACA($erou, $boss, 80)

echo "--- REZULTAT FINAL ---"
echo "HP Dragon in variabila globala: " + $boss.stats.hp

set $boss = Entitate("Dragon", Statistici(500, 200, 30), Pozitie(150, 50))
set $boss = ATACA($erou, $boss, 80)
echo $boss.stats.hp

# 1. Pregătire mediu
unset all
set $boss = Entitate("Dragon", Statistici(500, 200, 30), Pozitie(150, 50))

# 2. Definim funcția de Teleportare
# Observă: Nu returnăm nimic, lucrăm direct pe @
func TELEPORT_GLOBAL($nume_entitate,$nou_x)
[INFO] Started recording function: TELEPORT_GLOBAL
    echo "--- Initiere Teleportare ---"
    echo "Tinta: " + $nume_entitate
    
    # Folosim variabila variabilă pentru a accesa rădăcina globală
    # @$nume_entitate se traduce în @boss dacă $nume_entitate este "boss"
    #set @$nume_entitate.poz.x = $nou_x
    set @boss.poz.x = $nou_x
    echo "Sistem: Coordonata X a fost modificata global la " + $nou_x
endfunc

# 3. Execuție Test
echo "Pozitie initiala Dragon X: " + $boss.poz.x

# Apelăm funcția trimițând numele variabilei globale ca string
TELEPORT_GLOBAL("boss", 999)

echo ""
echo "--- VERIFICARE DUPĂ TELEPORTARE ---"
echo "Pozitie finala Dragon X (Global): " + $boss.poz.x

# 4. Test de Shadowing vs Global
# Verificăm dacă putem avea o variabilă locală cu același nume 
# fără să o afectăm pe cea globală
func TEST_SHADOW()
    set $boss = "Sunt un simplu cavaler local"
    set @boss.nume = "Dragon Suprem"
    echo "Local $boss: " + $boss
    echo "Global @boss.nume: " + @boss.nume
endfunc

TEST_SHADOW()
echo "Dupa Shadowing, numele global este: " + $boss.nume
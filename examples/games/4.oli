# --- SETUP PLUGINS ---
plugin "x64/Release/oli_console"
plugin "x64/Release/oli_plugin"

 set $stars = []
 for $i = 0 to 30 do set $v = PUSH($stars, { "x": RANDOM(1, 78), "y": RANDOM(1, 23) }) endfor

# --- FUNCȚIE DESENARE CHENAR ---
func DRAW_FRAME($w, $h, $color)
    # Desenăm linia de sus la y=0 și linia de jos la y=24
    for $x = 0 to $w - 1 do
        set $v = DB_PUT($x, 0, "=", $color)
        set $v = DB_PUT($x, $h - 1, "=", $color)
    endfor
    
    # Desenăm marginile laterale
    for $y = 0 to $h - 1 do
        set $v = DB_PUT(0, $y, "|", $color)
        set $v = DB_PUT($w - 1, $y, "|", $color)
    endfor
endfunc

# --- FUNCȚIE EXPLOZIE BOSS ---
func BOSS_EXPLOSION($x, $y)
    for $e = 0 to 8 do
        set $v = DB_INIT(80, 25)
        for $p = 0 to 20 do
            # Generăm fragmente de "foc" în jurul coordonatelor Boss-ului
            set $v = DB_PUT($x + RANDOM(-4, 4), $y + RANDOM(-2, 2), "#", RANDOM(12, 14))
        endfor
        set $v = DB_PRESENT()
        set $v = SLEEP(80)
    endfor
endfunc

# --- FUNCȚIE ANIMAȚIE FINAL ---
func END_ANIMATION($win)
    set $v = CON_CLS()
    for $t = 0 to 10 do
        set $v = DB_INIT(80, 25)
        for $i = 0 to 40 do
            set $v = DB_PUT(RANDOM(0, 79), RANDOM(0, 24), "*", RANDOM(9, 15))
        endfor
        if $win == true then
            set $v = DB_PUT(30, 12, "!!! VICTORIE TOTALA !!!", 14)
        else
            set $v = DB_PUT(30, 12, "--- NAVA DISTRUSA ---", 12)
        endif
        set $v = DB_PRESENT()
        set $v = SLEEP(100)
    endfor
endfunc

# --- FUNCȚIE PRINCIPALĂ JOC ---
func START_GAME()
    set $SW = 80
    set $SH = 25
    set $v = CON_SCREEN($SW, $SH)
    set $v = DB_INIT($SW, $SH)
    set $v = CURSOR(0)

	

    # Resetăm entitățile la fiecare început de joc
   
    
    set $enemies = []
    for $i = 0 to 5 do set $v = PUSH($enemies, { "x": RANDOM(10, 70), "y": RANDOM(2, 6), "d": 1, "alive": 1 }) endfor
    
    set $boss = { "x": 40, "y": -5, "d": 1, "hp": 5, "active": 0 }
    set $bullets = []
    set $px = 40
    set $py = 22
    set $cooldown = 0
    set $playing = true
    set $winStatus = false

    while $playing do
		set $v = DB_INIT($SW, $SH)
		
		set $v = DRAW_FRAME($SW, $SH, 8)
		
        # 1. Fundal stele (Varianta Safe)
		cycle $stars as $s do
			set $s["y"] = $s["y"] + 1
			
			# Dacă a atins marginea de jos (24 e chenarul, deci ne oprim la 23)
			if $s["y"] > 23 then 
				set $s["y"] = 1 
				set $s["x"] = RANDOM(1, 78) # Reapare în interiorul pereților
			endif
			
			set $v = DB_PUT($s["x"], $s["y"], ".", 8)
		endcycle

        # 2. Input
        if KEY_STATE(37) == 1 then if $px > 2 then set $px = $px - 1 endif endif
        if KEY_STATE(39) == 1 then if $px < 77 then set $px = $px + 1 endif endif
        if $cooldown > 0 then set $cooldown = $cooldown - 1 endif
        if KEY_STATE(32) == 1 then
            if $cooldown == 0 then
                set $v = PUSH($bullets, { "x": $px, "y": $py - 1 })
                set $cooldown = 4
            endif
        endif

        # 3. Gloanțe
        cycle $bullets as $b do
            if $b["y"] > -1 then
                set $b["y"] = $b["y"] - 1
                if $b["y"] > 0 then set $v = DB_PUT($b["x"], $b["y"], "|", 11) endif
            endif
        endcycle

        # 4. Inamici Mici
        set $rem = 0
        cycle $enemies as $en do
            if $en["alive"] == 1 then
                set $rem = $rem + 1
                set $en["x"] = $en["x"] + $en["d"]
                if $en["x"] > 77 then set $en["d"] = -1 endif
                if $en["x"] < 2  then set $en["d"] = 1 endif
                
                cycle $bullets as $b do
                    if $b["y"] == $en["y"] then
                        if $b["x"] >= $en["x"] - 1 then
                            if $b["x"] <= $en["x"] + 1 then
                                set $en["alive"] = 0
                                set $b["y"] = -1
                            endif
                        endif
                    endif
                endcycle
                set $v = DB_PUT($en["x"] - 1, $en["y"], "<W>", 12)
            endif
        endcycle

        # 5. Boss
        if $rem == 0 then
            set $boss["active"] = 1
            # Coborâre
			if $boss["y"] < 4 then set $boss["y"] = $boss["y"] + 0.1 endif
			
			# Mișcare laterală sigură
			set $boss["x"] = $boss["x"] + $boss["d"]
			
			# Verificăm marginile cu setare fixă a direcției
			if $boss["x"] > 74 then 
				set $boss["d"] = -1 # Mergi la stânga, obligatoriu!
			endif
			if $boss["x"] < 5 then 
				set $boss["d"] = 1  # Mergi la dreapta, obligatoriu!
			endif

            cycle $bullets as $b do
                if $b["y"] == $boss["y"] or $b["y"] == $boss["y"] + 1 then
                    if $b["x"] >= $boss["x"] - 2 then
                        if $b["x"] <= $boss["x"] + 2 then
                            set $boss["hp"] = $boss["hp"] - 1
                            set $b["y"] = -1
                        endif
                    endif
                endif
            endcycle

            # --- LOGICĂ RANDARE BOSS (FĂRĂ SUPRAPUNERE) ---
			if $boss["hp"] <= 0 then
				set $playing = false
				set $winStatus = true
				set $v = BOSS_EXPLOSION($boss["x"], $boss["y"])
			else
				# 1. Corpul [MWM] - desenăm doar dacă e la linia 1 sau mai jos
				if $boss["y"] >= 1 then
					set $v = DB_PUT($boss["x"] - 2, $boss["y"], "[MWM]", 13)
				endif

				# 2. Aripile V V - fiind la y + 1, vor apărea primele din chenar
				if $boss["y"] + 1 >= 1 then
					set $v = DB_PUT($boss["x"] - 1, $boss["y"] + 1, "V V", 13)
				endif
				
				# 3. HP-ul - fiind la y - 1, apare ultimul (după ce corpul a coborât la y=2)
				if $boss["y"] - 1 >= 1 then
					set $hpText = "HP: " + $boss["hp"]
					set $v = DB_PUT($boss["x"] - 2, $boss["y"] - 1,  $hpText, 10)
				endif
			endif
        endif

        set $v = DB_PUT($px, $py, "A", 14)
        set $v = DB_PRESENT()
        set $v = SLEEP(16)
        
        if KEY_STATE(81) == 1 then set $playing = false endif
    endwhile
    
    return $winStatus
endfunc
# --- LOGICĂ REPLAY ACTUALIZATĂ ---
set $wantsToPlay = true

while $wantsToPlay do
    # 1. CURĂȚĂM TOTUL înainte de a începe (esențial!)
    set $v = CON_CLS()
    
    set $result = START_GAME()
    set $v = END_ANIMATION($result)
    
    # 2. Întrebare Replay (Curățăm bufferul de DB pentru mesaj)
    set $v = DB_INIT(80, 25)
    set $v = DB_PUT(25, 12, "Vrei sa mai joci? (Y / N)", 15)
    set $v = DB_PRESENT()
    
    set $waiting = true
    while $waiting do
        set $choice = GET_KEY()
        if $choice != 0 then
            if $choice == 121 or $choice == 89 then
                set $waiting = false
                set $wantsToPlay = true
                # Curățăm ecranul Imediat ce a ales DA
                set $v = CON_CLS() 
            endif
            if $choice == 110 or $choice == 78 then
                set $waiting = false
                set $wantsToPlay = false
            endif
        endif
        set $v = SLEEP(50)
    endwhile
endwhile

# --- EXIT FINAL ---
set $v = CON_CLS()
echo "Misiune incheiata. La revedere, Comandante!"
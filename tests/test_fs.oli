plugin oli_filesys
echo "-----------------------------------------\n"
echo "-----------------------------------------\n"
unset all

# Folosim func pentru a izola variabilele în stiva locală (StackFrame) per apel recursiv
func list_dir_rec($dir_path)
    echo "Incep pt: " + $dir_path
    
    # Alocăm variabilele local
    set $files = FS_LIST_DIR($dir_path)
    
    cycle $files as $file do 
        set $file_path = $dir_path + "/" + $file 
        
        if FS_FILE_EXISTS($file_path) then 
            if FS_IS_DIR($file_path) then 
                echo "Intram in: " + $file_path
                # Apel funcție cu paranteze
                list_dir_rec($file_path)
            else 
                echo "Fisierul: " + $file_path + " exista si are dimensiunea: " + FS_FILE_SIZE($file_path)/1024 + " KB (" + FS_FILE_SIZE($file_path) + " bytes)" 
            endif 
        else 
            if FS_IS_DIR($file_path) then 
                list_dir_rec($file_path) 
            else 
                echo "Fisierul: " + $file_path + " NU EXISTA!" 
            endif 
        endif 
    endcycle
endfunc

# Apelăm funcția principală folosind ghilimele evadate corect sau caractere sigure
list_dir_rec("c:/")
input()



plugin "oli_winui"
config echo off

echo "=== Lansare Interfata Grafica cu Click Nativ ==="

# =================================================================
# DEFINE CLASA DE BAZA UiControl
# =================================================================
def class UiControl { 
    id, 
    set_prop($name, $val), 
    get_prop($name), 
    bind($event, $func),
    set_text($text),
    get_text(),
    set_anchor($type),
    set_width_mode($mode),
    set_height_mode($mode),
    set_margin($val),
    set_visible($bool),
	set_font_size($size)
}

func UiControl::set_prop($name, $val) return UI_SET_PROPERTY($this, $name, $val) endfunc
func UiControl::get_prop($name)       return UI_GET_PROPERTY($this, $name) endfunc
func UiControl::bind($event, $func)   return UI_BIND_EVENT($this.id, $event, $func) endfunc
func UiControl::set_text($text)       return $this.set_prop("text", $text) endfunc
func UiControl::get_text()            return $this.get_prop("text") endfunc
func UiControl::set_anchor($type)     return $this.set_prop("anchor", $type) endfunc
func UiControl::set_width_mode($mode) return $this.set_prop("width_mode", $mode) endfunc
func UiControl::set_height_mode($mode) return $this.set_prop("height_mode", $mode) endfunc
func UiControl::set_margin($val)      return $this.set_prop("margin", $val) endfunc
func UiControl::set_visible($bool)    return $this.set_prop("visible", $bool) endfunc
func UiControl::set_font_size($size)    return $this.set_prop("font_size", $size) endfunc

# =================================================================
# INCAPSULARE CORECTA PENTRU WINAPP 
# =================================================================
def class WinApp { create(), init(), run() }

func WinApp::create()
       $this  = CREATE_WINAPP()
	   return $this
endfunc

func WinApp::init()
	$this = $this.create()
    # Apelam functia nativa din inregistrarea DLL-ului, trimitandu-i contextul $this
    return WINAPP::INIT($this)
endfunc

func WinApp::run()
    return WINAPP::RUN($this)
endfunc

# =================================================================
# INCAPSULARE CORECTA PENTRU WINWINDOW
# =================================================================
def class WinWindow extends UiControl { id, title, init($id, $title), show(), set_layout($style), set_icon($path) }

func WinWindow::init($id, $title)
    # Generăm obiectul nativ direct din interiorul constructorului clasei
	$this.id = $id
	echo "INAINTE DE CREATE WIN"
    $this = CREATE_WINWINDOW($id, $title)
	echo "DUPA  CREATE WIN"
    return $this
endfunc

func WinWindow::show()
    return WINWINDOW::SHOW($this)
endfunc

func WinWindow::set_layout($style)
    return UI_SET_PROPERTY($this, "layout", $style)
endfunc

func WinWindow::set_icon($path)
    return $this.set_prop("icon", $path)
endfunc


# =================================================================
# CLASELE PENTRU CONTROALELE COPIL (Raman neschimbate)
# =================================================================
def class WinPanel extends UiControl { init($id, $parentId, $x, $y, $w, $h), set_layout($style) }
func WinPanel::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("PANEL", $id, $parentId, $x, $y, $w, $h,)
endfunc

func WinPanel::set_layout($style) return $this.set_prop("layout", $style) endfunc

def class WinButton extends UiControl { init($id, $parentId, $x, $y, $w, $h, $text) }
func WinButton::init($id, $parentId, $x, $y, $w, $h, $text)
    $this.id = $id
    UI_CREATE_CONTROL("BUTTON", $id, $parentId, $x, $y, $w, $h, $text)
endfunc

def class WinCodeView extends UiControl { init($id, $parentId, $x, $y, $w, $h), set_syntax_path($path) }
func WinCodeView::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("CODEVIEW", $id, $parentId, $x, $y, $w, $h)
	#$this.set_font_size(12)
endfunc

func WinCodeView::set_syntax_path($path)
    return $this.set_prop("syntax_path", $path)
endfunc

# =================================================================
# CLASA MENIU
# =================================================================

def class WinMenu { id, init($id, $parentId), add_item($itemId, $text), add_separator($sepId), add_submenu($text, $childMenuObj) }

func WinMenu::init($id, $parentId)
    $this.id = $id
    UI_CREATE_CONTROL("MENU", $id, $parentId)
    return $this
endfunc

func WinMenu::add_item($itemId, $text)
	echo "APEL UI_CALL_METHOD pentru " .. $itemId
    return UI_CALL_METHOD($this.id, "add_item", $itemId, $text)
endfunc

func WinMenu::add_separator($sepId)
    return UI_CALL_METHOD($this.id, "add_separator", $sepId)
endfunc

func WinMenu::add_submenu($text, $childMenuObj)
    return UI_CALL_METHOD($this.id, "add_submenu", $text, $childMenuObj.id)
endfunc


# =================================================================
# CLASA WINDIALOG
# =================================================================

def class FileDialog { title, type, show() }

func FileDialog::show()
    return UI_FILE_DIALOG($this.type, $this.title)
endfunc

# =================================================================
# CLASA TABCONTROL
# =================================================================

def class WinTabControl extends UiControl { init($id, $parentId, $x, $y, $w, $h), add_tab($title, $panelId), switch_page($index),select_tab_by_id($panelId), refresh() }

func WinTabControl::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("TABCONTROL", $id, $parentId, $x, $y, $w, $h)
endfunc

func WinTabControl::add_tab($title, $panelId)
    return UI_CALL_METHOD($this.id, "add_tab_page", $title, $panelId)
endfunc

func WinTabControl::switch_page($index)
    return UI_CALL_METHOD($this.id, "switch_page", $index)
endfunc

func WinTabControl::refresh()
    return UI_CALL_METHOD($this.id, "refresh")
endfunc

func WinTabControl::select_tab_by_id($panelId)
    return UI_CALL_METHOD($this.id, "select_tab_by_id", $panelId)
endfunc


# =================================================================
# CLASA WINRICHEDIT (Consolă / Editor)
# =================================================================
def class WinRichEdit extends UiControl { 
    init($id, $parentId, $x, $y, $w, $h), 
    append_text($text),
    set_read_only($bool) 
}

func WinRichEdit::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    UI_CREATE_CONTROL("RICHEDIT", $id, $parentId, $x, $y, $w, $h)
endfunc

func WinRichEdit::append_text($text)
    # Acesta apelează vRichEdit::callMethod("append_text") din C++
    return UI_CALL_METHOD($this.id, "append_text", $text)
endfunc

func WinRichEdit::set_read_only($bool)
    return UI_CALL_METHOD($this.id, "set_read_only", $bool)
endfunc


# =================================================================
# CLASA WINRICHCONSOLE (Consolă Automată)
# =================================================================
# Extinde WinRichEdit pentru a refolosi funcțiile de text
def class WinRichConsole extends WinRichEdit { 
    init($id, $parentId, $x, $y, $w, $h)
}

func WinRichConsole::init($id, $parentId, $x, $y, $w, $h)
    $this.id = $id
    # Atenție: În C++ Factory va trebui să folosești tipul "RICHCONSOLE"
    UI_CREATE_CONTROL("RICHCONSOLE", $id, $parentId, $x, $y, $w, $h)
endfunc

echo "AM DEFINIT CLASELE"
# --- OPTIMIZARE ---
config echo off
config max_iterations 0

# --- SETUP ---
plugin oli_canvas
plugin oli_fract
plugin oli_keyboard
plugin oli_time

set $v = CAN_INIT(640, 480, "Oli Warp Speed Engine")
set $ptr = CAN_GET_PTR()
set $w = CAN_GET_WIDTH()
set $h = CAN_GET_HEIGHT()

set $warp = 1.0

echo "Space pentru Warp Speed, Q pentru Iesire"

while true do
    # Control viteză
    if KEY_STATE(32) == 1 then
        set $warp = $warp + 0.5
        if $warp > 10.0 then set $warp = 10.0 endif
    else
        set $warp = $warp - 0.2
        if $warp < 1.0 then set $warp = 1.0 endif
    endif

    # Timp accelerat de Warp
    set $t = TIME() * $warp

    # Plugin-ul Starfield
    set $v = FX_STARFIELD($ptr, $w, $h, $t)
    
    # Adaugăm un mic efect de Plasma peste (Overlay) dacă Warp e mare
    if $warp > 5.0 then
        # Aceasta va crea un amestec interesant de culori
        # Poti comenta linia de mai jos daca vrei doar stelele curate
        # set $v = FRACT_PLASMA($ptr, $w, $h, $t)
    endif
    
    set $v = CAN_PRESENT()
    
    if KEY_STATE(81) == 1 then break endif
endwhile

CAN_CLOSE()
echo "Revenire in consola."
config win_app 0
plugin oli_system
plugin oli_filesys
plugin oli_compiler

include ("include\winui.oli")

# =================================================================
# CODUL PRINCIPAL (LOGICA DE SINCRONIZARE MULTI-TAB)
# =================================================================

$file = "" 
$oli_path = "oli.exe"
set $activeCodeView = null

# Funcție de sincronizare: Află ce tab e pe ecran și actualizează contextul IDE-ului
func UPDATE_ACTIVE_CONTEXT()
    # Întrebăm componenta C++ care este ID-ul panelului activ în acest moment
    $active_id = $tabs.get_prop("active_tab_id")
    
    if $active_id != "" then
        # Re-ancorăm dinamic obiectul de control pe ID-ul curent
        set $currentView = new("WinCodeView")
        $currentView.id = $active_id
        
        # Preluăm calea absolută pe care am salvat-o în el la deschidere
        @file = $currentView.get_prop("file_path")
        @activeCodeView = $currentView
    else
        @file = ""
        @activeCodeView = null
		init_first_tab()
    endif
endfunc

func GET_EXE_NAME($cale)
    $nume_fisier = FS_GET_FILENAME($cale)
    return REPLACE($nume_fisier, ".oli", ".exe")
endfunc

# =================================================================
# LOGICA DE RUN (SECURIZATĂ COMPLET ANTI-RUN VECHI)
# =================================================================
func run_click()
    UPDATE_ACTIVE_CONTEXT()

    if @file == "" then
        menu_save_as_click()
        if @file != "" then run_click() endif
        return
    endif

    # Calculăm numele final al executabilului (.exe)
    $exe_file = GET_EXE_NAME(@file)

    # 🔥 PASUL 1: Ștergem violent vechiul executabil de pe disc!
    # Dacă compilarea eșuează, folderul va rămâne curat și nu va rula nimic fantomă
    FS_DELETE_FILE($exe_file)
    echo "[IDE] Am curățat vechiul executabil: " .. $exe_file

    # 2. AUTO-SALVARE SILENȚIOASĂ A CODULUI SURSĂ
    echo "[IDE] Auto-salvare în fundal pentru: " .. @file
    $cod_curent = $activeCodeView.get_text()
    WRITEFILE(@file, $cod_curent)

    $activeCodeView.set_prop("modified", false)
    $tabs.set_title_by_id(@activeCodeView.id, FS_GET_FILENAME(@file))

    # 🔥 PASUL 3: Compilăm și VERIFICĂM dacă a reușit!
    $build_result = menu_build_click()
    
    if $build_result != "SUCCESS" then
        echo "[❌ EROARE CRITICĂ] Compilarea a eșuat! Execuția a fost oprită în siguranță."
        return # 🔥 OPRIM EXECUȚIA AICI! Nu mai apelăm START_PROCESS!
    endif
    
    # PASUL 4: Dacă codul a trecut de 'if', înseamnă că noul .exe a fost generat cu succes!
    echo "LANSARE PROCES PROASPĂT COMPILAT: " .. $exe_file
    START_PROCESS($exe_file)
endfunc

# =================================================================
# LOGICA DE SALVARE (SAVE / SAVE AS)
# =================================================================

func execute_save_to_disk($calea_fisiere)
    if @activeCodeView == null then return endif
    
    $cod_curent = $activeCodeView.get_text()
    WRITEFILE($calea_fisiere, $cod_curent)
    
    # 🔥 RESETARE STARE: Îi spunem lui C++ că fișierul e curat acum
    $activeCodeView.set_prop("modified", false)
    
    # 🔥 RESETARE UI: Scoatem asteriscul și lăsăm doar numele curat
    $tab_id = @activeCodeView.id
    $tabs.set_title_by_id($tab_id, FS_GET_FILENAME($calea_fisiere))
    
    echo "[SUCCESS] Fișier salvat cu succes la: " .. $calea_fisiere
    #SHOW_MESSAGE("Salvare", "Fișierul a fost salvat cu succes!")
endfunc

func menu_save_click()
    UPDATE_ACTIVE_CONTEXT()
    if @file != "" then
        execute_save_to_disk(@file)
    else
        menu_save_as_click()
    endif
endfunc

func menu_save_as_click()
    UPDATE_ACTIVE_CONTEXT()
    if @activeCodeView == null then return endif

    set $dlg = new("FileDialog") 
	if @file == "" then @file = "untitled.oli" endif
    $path = UI_FILE_DIALOG(1, "Salvează fișierul...", @file) 
    
    if $path != "" then
        @file = $path  
        $activeCodeView.set_prop("file_path", $path)
        execute_save_to_disk(@file)
    endif
endfunc


func save_click()
    menu_save_click()
endfunc

func menu_new_click()
    echo "=== CREARE FIȘIER NOU ==="
    set $dlg = new("FileDialog")
    $dlg.title = "Creează un fișier nou Oli..."
    $dlg.type = 1  
    
    $path = $dlg.show()
    if $path != "" then
        @file = $path
        WRITEFILE(@file, "")
        
        # Deschidem fișierul nou direct într-un tab nou ca să poată fi editat separat!
        $newTabId = "tab_page_" .. FS_GET_FILENAME(@file)
        set $newView = new("WinCodeView")
        $newView.init($newTabId, "main_tabs", 0, 0, 0, 0)
		
		$newView.bind("modified", "on_file_modified")
		
        $newView.set_width_mode("FILL")
        $newView.set_height_mode("FILL")
        $newView.set_prop("file_path", @file) # 🔥 Reținem calea în C++
		$newView.set_font_size(14)
        
        $tabs.add_tab(FS_GET_FILENAME(@file), $newTabId)
        $newView.set_syntax_path("./olide/syntaxes/oli.xml")
        $newView.set_text("")
        $tabCount = $tabs.get_prop("tab_count")
        $tabs.switch_page($tabCount - 1)
        UPDATE_ACTIVE_CONTEXT()
        SHOW_MESSAGE("Fișier Nou", "Fișierul a fost creat și deschis în tab nou!")
    endif
endfunc

# 🔥 INTERCEPTĂM FILTRAT EVENIMENTUL DE CLOSE TAB PRIN MENIU / BUTON
func menu_close_click()
    $active_id = $tabs.get_prop("active_tab_id")
    if $active_id != "" then
        # Redirecționăm totul prin funcția inteligentă de verificare
        on_tab_close_requested($active_id)
    endif
endfunc


func menu_exit_click()
	exit()
endfunc

func menu_about_click()
	set $about_text = "Oli Engine v0.1"
	SHOW_MESSAGE("About oli:",$about_text)
endfunc


func menu_interpreter_click()
	START_PROCESS(@oli_path)
endfunc

func menu_command_click()
	OPEN_TERMINAL()
endfunc

func menu_compile_click()
    UPDATE_ACTIVE_CONTEXT()
    if @file == "" then return endif

    # 1. Curățăm consola grafică înainte de a începe
    $consoleOutput.set_text("")
    
    # 2. Apelăm direct funcția nativă din plugin!
    $res = COMPILE(@file)
    
    # 3. Opțional, poți verifica valoarea returnată pentru o logică suplimentară
    if $res != "SUCCESS" then
        echo "A apărut o eroare la compilarea fișierului."
    endif
endfunc

# =================================================================
# LOGICA DE BUILD (MODIFICATĂ SĂ RETURNEZE REZULTATUL VIRTUAL)
# =================================================================
func menu_build_click()
    UPDATE_ACTIVE_CONTEXT()
    if @file == "" then return "ERROR" endif

    # 1. Curățăm consola grafică înainte de a începe
    $consoleOutput.set_text("")
    
    # 2. Apelăm procesul nativ de build din plugin
    $res = BUILD(@file)
    
    # 3. Verificăm rezultatul și îl returnăm mai departe pentru logica de RUN
    if $res != "SUCCESS" then
        echo "A apărut o eroare în timpul procesului de Build standalone."
        return "ERROR" # 🔥 Returnăm starea ca să o prindem în run_click
    else
        echo "Procesul de generare a fost finalizat."
        return "SUCCESS" # 🔥 Returnăm succes
    endif
endfunc

# 🔥 LOGICA DE INTERCEPTARE ȘI SALVARE INTELIGENTĂ LA CLOSE
func on_tab_close_requested($tab_id)
    echo "[IDE] Cerere închidere tab: " .. $tab_id
    
    # Ancorăm dinamic un control temporar pe ID-ul tab-ului vizat
    set $checkView = new("WinCodeView")
    $checkView.id = $tab_id
    
    # Întrebăm direct C++ dacă fișierul este modificat
    $is_modified = $checkView.get_prop("modified")
    
    if $is_modified == true then
        $cale_originala = $checkView.get_prop("file_path")
        $nume_curat = FS_GET_FILENAME($cale_originala)
        if $nume_curat == "" then $nume_curat = "untitled.oli" endif
        
        # Apelăm dialogul nativ creat la Pasul 1
        $raspuns = UI_SHOW_QUESTION("Salvare modificări", "Fișierul '" .. $nume_curat .. "' a fost modificat.\nDorești să salvezi modificările înainte de a închide?")
        
        if $raspuns == "YES" then
            if $cale_originala == "" or $nume_curat == "untitled.oli" then
                # Fișierul este complet nou (untitled) -> Forțăm mutarea focusului pe el și deschidem Save As
                $tabs.select_tab_by_id($tab_id)
                UPDATE_ACTIVE_CONTEXT()
                menu_save_as_click()
                
                # Verificăm dacă userul chiar a salvat sau a dat Cancel în fereastra de selecție nume
                $cale_verificare = @activeCodeView.get_prop("file_path")
                if $cale_verificare == "" or $cale_verificare == "untitled.oli" then
                    echo "[IDE] Închidere anulată (Userul a renunțat la Save As)."
                    return # Oprim funcția, tab-ul RĂMÂNE deschis!
                endif
            else
                # Fișierul are deja o cale stabilă -> Îl salvăm silențios pe disc
                $cod_de_salvat = $checkView.get_text()
                WRITEFILE($cale_originala, $cod_de_salvat)
                echo "[IDE] Salvare automată reușită pentru: " .. $cale_originala
            endif
        endif
        
        if $raspuns == "CANCEL" then
            echo "[IDE] Închidere tab anulată de utilizator."
            return # Oprim funcția, tab-ul RĂMÂNE deschis!
        endif
    endif

    # Dacă fișierul nu e modificat, sau userul a ales "NO", sau a ales "YES" și s-a salvat cu succes:
    UI_CALL_METHOD("main_tabs", "remove_tab_page_by_id", $tab_id)
    
    # Re-sincronizăm imediat contextul IDE-ului pentru a vedea ce fișier a rămas activ pe ecran
    UPDATE_ACTIVE_CONTEXT()
    echo "[IDE] Tab-ul " .. $tab_id .. " a fost șters."
endfunc


# =================================================================
# EVENIMENT AUTOMAT: PROPAGARE CORECTĂ ASTERISC LA MODIFICARE (0 ARGUMENTE)
# =================================================================
func on_file_modified()
    # Întrebăm direct tab-ul activ în momentul tastării (pentru că acolo scrie userul)
    $active_id = $tabs.get_prop("active_tab_id")
    
    if $active_id != "" then
        # Extragem numele curat al fișierului pentru a-i aplica asteriscul
        $clean_name = REPLACE($active_id, "tab_page_", "")
        
        # Trimitem comanda de setare titlu direct pe id-ul detectat
        $tabs.set_title_by_id($active_id, $clean_name .. " *")
    endif
endfunc


echo "CREEZ APP"
set $app = new("WinApp")
$app.init() 

echo "CREEZ WIN"

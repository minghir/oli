# --- OPTIMIZARE ---
config echo off
config max_iterations 0

# --- SETUP ---
plugin oli_canvas
plugin oli_math
plugin oli_keyboard
plugin oli_time

func RENDER_JULIA_HD()
set $SW = 100
set $SH = 100
set $v = CAN_INIT($SW, $SH, "Oli Engine - Julia Test")
    
    set $maxIter = 32
    set $t = 0

    while true do
        # Nu mai folosim CAN_CLS pentru că desenăm pe tot ecranul oricum
        
        # TIME() din plugin-ul tău de math/time
        set $t = TIME() * 30
        
        # Constantele pentru formă (folosim SIN/COS în grade)
        set $cX = 0.7 * COS($t)
        set $cY = 0.27 * SIN($t * 0.5)
        
        for $y = 0 to $SH - 1 do
            # Pre-calculăm Y pentru viteză
            set $zy_init = 1.0 * (2.0 * $y / $SH - 1.0)
            
            for $x = 0 to $SW - 1 do
                set $zx = 1.5 * (2.0 * $x / $SW - 1.0)
                set $zy = $zy_init
                
                set $i = 0
                while $i < $maxIter do
                    set $zx2 = $zx * $zx
                    set $zy2 = $zy * $zy
                    
                    if ($zx2 + $zy2) > 4 then
                        break
                    endif
                    
                    set $zy = 2.0 * $zx * $zy + $cY
                    set $zx = $zx2 - $zy2 + $cX
                    set $i = $i + 1
                endwhile
                
                # --- LOGICĂ CULORI RGB ---
                # Dacă i == maxIter, suntem în interiorul fractalului (Negru)
                if $i == $maxIter then
                    set $color = 0
                else
                    # Creăm un gradient de albastru/cyan bazat pe numărul de iterații
                    # Formula: (R << 16) + (G << 8) + B
                    set $blue = 128 + ($i * 4)
                    set $cyan = ($i * 6)
                    if $cyan > 255 then 
                        set $cyan = 255 
                    endif
                    
                    set $color = ($cyan * 256) + $blue
                endif
                
                # Punem pixelul direct în buffer-ul de memorie
                set $v = CAN_PUT($x, $y, $color)
            endfor
        endfor
        
        # Transferăm tot buffer-ul pe ecran și procesăm mesajele Windows
        set $v = CAN_PRESENT()
        set $state = KEY_STATE(81)
        if $state > 0.5 then # Q pentru ieșire
            break
        endif
    endwhile
endfunc

set $v = RENDER_JULIA_HD()
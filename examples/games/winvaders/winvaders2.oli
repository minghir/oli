# --- SETUP ---
config echo off
plugin oli_opengl
plugin oli_keyboard

# 1. DEFINIRE CLASE (La începutul scriptului)
def class Bullet { x, y, active, speed, move() }
func Bullet::move()
    if $this.active == 1 then
        set $this.y = $this.y + $this.speed
        if $this.y > 350 then set $this.active = 0 endif
    endif
endfunc

def class Enemy { x, y, alive, move($d, $s) }
func Enemy::move($d, $s)
    if $this.alive == 1 then
        set $this.x = $this.x + ($s * $d)
    endif
endfunc

# 2. INIȚIALIZARE MOTOR
GL_INIT(800, 600, "Oli Invaders - OOP Fixed")

# 3. INSTANȚIERE OBIECTE
set $numE = 6
set $enemies = array($numE)
for $i = 0 to $numE - 1 do
    set $e = new("Enemy")
    $e.x = ($i * 100) - 250
    $e.y = 200
    $e.alive = 1
    set $enemies[$i] = $e
endfor

set $maxB = 3
set $bullets = array($maxB)
for $i = 0 to $maxB - 1 do
    set $b = new("Bullet")
    $b.active = 0
    $b.speed = 15
    set $bullets[$i] = $b
endfor

set $px = 0
set $eDir = 1

# --- LOOP PRINCIPAL ---
while true do
    GL_CLEAR(0x050515)

    # Control Jucător
    if KEY_STATE(37) == 1 then set $px = $px - 7 endif
    if KEY_STATE(39) == 1 then set $px = $px + 7 endif
    GL_POINT($px, -250, 40, 0x00FF00)

    # Tragere
    if KEY_STATE(32) == 1 then
        for $i = 0 to $maxB - 1 do
            if $bullets[$i].active == 0 then
                set $bullets[$i].active = 1
                set $bullets[$i].x = $px
                set $bullets[$i].y = -230
                break
            endif
        endfor
    endif

    # Update Gloanțe (Acum folosim metoda move)
    for $i = 0 to $maxB - 1 do
        if $bullets[$i].active == 1 then
            $bullets[$i].move()
            GL_POINT($bullets[$i].x, $bullets[$i].y, 10, 0xFFFF00)
        endif
    endfor

    # Update Inamici
    set $edge = 0
    for $i = 0 to $numE - 1 do
        if $enemies[$i].alive == 1 then
            $enemies[$i].move($eDir, 3)
            if $enemies[$i].x > 350 || $enemies[$i].x < -350 then set $edge = 1 endif
            GL_POINT($enemies[$i].x, $enemies[$i].y, 45, 0xFF0000)
            
            # Coliziune
            for $j = 0 to $maxB - 1 do
                if $bullets[$j].active == 1 then
                    if ABS($bullets[$j].x - $enemies[$i].x) < 30 then
                        if ABS($bullets[$j].y - $enemies[$i].y) < 30 then
                            set $enemies[$i].alive = 0
                            set $bullets[$j].active = 0
                        endif
                    endif
                endif
            endfor
        endif
    endfor

    if $edge == 1 then
        set $eDir = $eDir * -1
        for $k = 0 to $numE - 1 do set $enemies[$k].y = $enemies[$k].y - 30 endfor
    endif

    GL_PRESENT()
    if KEY_STATE(27) == 1 then break endif
endwhile
GL_CLOSE()
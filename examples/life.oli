# --- GAME OF LIFE OLI VERSION (FIXED MEMORY) ---
config echo off
config max_iterations 0

plugin oli_console
plugin oli_math
plugin oli_time
plugin oli_keyboard

func RUN_GOL($size)
    set $W = 80; set $H = 25
    set $v = CON_SCREEN($W, $H); set $v = CURSOR(0)
    
    # 1. Inițializare Grid
    set $grid = []
    for $y = 0 to $H - 1 do
        set $row = []
        for $x = 0 to $W - 1 do
            set $r = RANDOM(0, 10)
            if $r > 8 then 
				set $val = 1 
			else 
				set $val = 0 
			endif
            set $v = PUSH($row, $val)
        endfor
        set $v = PUSH($grid, $row)
    endfor

    while true do
        set $v = DB_INIT($W, $H)
        
        # FOARTE IMPORTANT: Creăm un array nou gol pentru noua generație
        set $nextGen = [] 
        
        for $y = 0 to $H - 1 do
            set $nextRow = []
            for $x = 0 to $W - 1 do
                set $neighbors = 0
                
                # Vecini (Folosim variabile locale pt viteză)
                for $ny = -1 to 1 do
                    set $ty = INT($y + $ny + $H) % $H
                    for $nx = -1 to 1 do
                        if $ny != 0 or $nx != 0 then
                            set $tx = INT($x + $nx + $W) % $W
                            # Citim din grid-ul vechi (nemodificat)
                            set $neighbors = $neighbors + $grid[$ty][$tx]
                        endif
                    endfor
                endfor

                set $state = $grid[$y][$x]
                set $isAlive = 0
                
                if $state == 0 then
                    if $neighbors == 3 then 
						set $isAlive = 1 
					endif
                else
                    if $neighbors == 2 or $neighbors == 3 then 
						set $isAlive = 1 
					endif
                endif

                set $v = PUSH($nextRow, $isAlive)
                
                if $isAlive == 1 then
                    set $v = DB_PUT($x, $y, "O", 10)
                endif
            endfor
            set $v = PUSH($nextGen, $nextRow)
        endfor

        # Aici tăiem legătura cu vechiul pointer
        set $grid = $nextGen
        
        set $v = DB_PRESENT()
        #set $v = WAIT(10)
        if KEY_STATE(81) == 1 then break endif 
    endwhile
endfunc

set $v = RUN_GOL(0)
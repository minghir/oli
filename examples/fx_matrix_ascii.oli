config echo off
config max_iterations 0

plugin oli_canvas
plugin oli_fract
plugin oli_keyboard

set $v = CAN_INIT(640, 480, "Matrix ASCII")
set $ptr = CAN_GET_PTR()
set $w = CAN_GET_WIDTH()
set $h = CAN_GET_HEIGHT()

while true do
    set $res = FX_MATRIX_ASCII($ptr, $w, $h)
    CAN_PRESENT()
    if KEY_STATE(81) == 1 then break endif
endwhile

CAN_CLOSE()

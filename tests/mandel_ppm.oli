plugin oli_math
# 1. Configurare
set $w = 1024
set $h = 1024
set $maxIter = 256
set $pixelCount = $w * $h
set $data = array(1 + ($pixelCount * 3))

# 2. HEADER FIX: Folosim spații simple pentru primele separări
# P6[spațiu]512[spațiu]512[spațiu]255[newline]
set $data[0] = "P6 1024 1024 255\n"

echo "Generare Fractal... Te rog asteapta."

for $y = 0 to $h - 1 do
    for $x = 0 to $w - 1 do
        # Normalizare
        set $nx = (1.0 * $x / $w) - 0.5
        set $ny = (1.0 * $y / $h) - 0.5
        set $cx = ($nx * 3.0) - 0.5
        set $cy = ($ny * 3.0)        
        set $zx = 0.0
        set $zy = 0.0
        set $it = 0
       
        while ($zx * $zx + $zy * $zy < 4.0) && ($it < $maxIter) do
            set $xt = $zx * $zx - $zy * $zy + $cx
            set $zy = 2.0 * $zx * $zy + $cy
            set $zx = $xt
            set $it = $it + 1
        endwhile
        set $idx = 1 + (($y * $w + $x) * 3)
        
        if $it == $maxIter then
            set $data[$idx] = 0
            set $data[$idx+1] = 0
            set $data[$idx+2] = 0
        else
            # Folosim multiplicatori diferiți pentru a „defaza” culorile
            set $data[$idx]   = ($it * 13) % 256  # Roșu
            set $data[$idx+1] = ($it * 7) % 256   # Verde
            set $data[$idx+2] = ($it * 25) % 256  # Albastru
        endif
    endfor
    if ($y % 128) == 0 then echo "Progres: " + (($y / $h) * 100) + "%" endif
endfor

writefile("mandelbrot_gimp_v2.ppm", $data)

plugin oli_net
plugin oli_opengl
plugin oli_miniaudio

CONFIG WIN_APP 1

$audio_ok = SND_INIT()
if $audio_ok == 0 then
    echo "Avertisment: Nu s-a putut inițializa placa de sunet!"
endif

$snd_hit = SND_LOAD("hit.mp3")
$snd_score = SND_LOAD("score.wav")

$sock = NET_BIND(8080)
if $sock < 0 then return 0 endif

# Adresa și portul clientului se vor completa DINAMIC la conectare
$client_ip = ""
$client_port = 0
$client_connected = 0

# Stare Joc
$p1_y = 300
$p2_y = 300
$target_p2_y = 300

$ball_x = 400
$ball_y = 300
$ball_vx = 5
$ball_vy = 3

$score1 = 0
$score2 = 0
$max_score = 11
$game_state = 0
$winner = 0

$start_delay = 180
$restart_timer = 300

GL_INIT(800, 600, "Oli Pong 1v1 - HOST")

$running = 1
while $running do
    $m_y = GL_MOUSE_Y()
    if $m_y > 0 then $p1_y = $m_y endif

    # 1. Rețea: Drenare UDP & Extragere IP/Port Client din pachet
    $drain = 1
    while $drain == 1 do
        $pkt = NET_RECV_FROM($sock)
        if HASKEY($pkt, "data") then
            $data_str = $pkt["data"]
            if $data_str != "" then
                $target_p2_y = INT($data_str)
                
                # Înregistrăm dinamic adresa IP și Portul de pe care trimite Clientul
                if $client_connected == 0 then
                    if HASKEY($pkt, "ip") then $client_ip = $pkt["ip"] endif
                    if HASKEY($pkt, "port") then $client_port = INT($pkt["port"]) endif
                    $client_connected = 1
                    echo "Client conectat de la: " .. $client_ip .. ":" .. STR($client_port)
                endif
            else
                $drain = 0
            endif
        else
            $drain = 0
        endif
    endwhile

    $p2_y = $p2_y + ($target_p2_y - $p2_y) * 0.35

    # 2. Logica de Joc
    if $game_state == 0 then
        if $client_connected == 1 then
            if $start_delay > 0 then
                $start_delay = $start_delay - 1
            endif
        endif

        if $client_connected == 1 then
            if $start_delay == 0 then
                $ball_x = $ball_x + $ball_vx
                $ball_y = $ball_y + $ball_vy

                # Coliziuni pereți
                if $ball_y <= 15 then
                    $ball_y = 15
                    $ball_vy = ABS($ball_vy)
                    SND_PLAY($snd_hit)
                endif
                if $ball_y >= 585 then
                    $ball_y = 585
                    $ball_vy = ABS($ball_vy) * -1
                    SND_PLAY($snd_hit)
                endif

                # Coliziune P1
                if $ball_x <= 30 then
                    if $ball_y >= ($p1_y - 50) then
                        if $ball_y <= ($p1_y + 50) then
                            $ball_x = 30
                            if ABS($ball_vx) < 18 then
                                $ball_vx = ABS($ball_vx) + 1.2
                                if $ball_vy > 0 then $ball_vy = $ball_vy + 0.5 else $ball_vy = $ball_vy - 0.5 endif
                            endif
                            SND_PLAY($snd_hit)
                        endif
                    endif
                endif

                # Coliziune P2
                if $ball_x >= 770 then
                    if $ball_y >= ($p2_y - 50) then
                        if $ball_y <= ($p2_y + 50) then
                            $ball_x = 770
                            if ABS($ball_vx) < 18 then
                                $ball_vx = (ABS($ball_vx) + 1.2) * -1
                                if $ball_vy > 0 then $ball_vy = $ball_vy + 0.5 else $ball_vy = $ball_vy - 0.5 endif
                            endif
                            SND_PLAY($snd_hit)
                        endif
                    endif
                endif

                # GOL P2
                if $ball_x < 0 then
                    $score2 = $score2 + 1
                    $ball_x = 400
                    $ball_y = 300
                    $ball_vx = 5
                    $ball_vy = 3
                    $start_delay = 60
                    SND_PLAY($snd_score)

                    if $score2 >= $max_score then
                        if $score2 >= ($score1 + 2) then
                            $game_state = 1
                            $winner = 2
                            $restart_timer = 300
                        endif
                    endif
                endif

                # GOL P1
                if $ball_x > 800 then
                    $score1 = $score1 + 1
                    $ball_x = 400
                    $ball_y = 300
                    $ball_vx = -5
                    $ball_vy = 3
                    $start_delay = 60
                    SND_PLAY($snd_score)

                    if $score1 >= $max_score then
                        if $score1 >= ($score2 + 2) then
                            $game_state = 1
                            $winner = 1
                            $restart_timer = 300
                        endif
                    endif
                endif
            endif
        endif
    else
        if $restart_timer > 0 then
            $restart_timer = $restart_timer - 1
        else
            $score1 = 0
            $score2 = 0
            $ball_x = 400
            $ball_y = 300
            $ball_vx = 5
            $ball_vy = 3
            $game_state = 0
            $winner = 0
            $start_delay = 180
            $restart_timer = 300
        endif
    endif

    # 3. Trimitere Stare Extinsă prin UDP (Doar dacă un client este conectat)
    if $client_connected == 1 then
        $send_vx = $ball_vx
        $send_vy = $ball_vy
        if $game_state == 1 or $start_delay > 0 then
            $send_vx = 0
            $send_vy = 0
        endif

        $state = STR($p1_y) .. "," .. STR($ball_x) .. "," .. STR($ball_y) .. "," .. STR($send_vx) .. "," .. STR($send_vy) .. "," .. STR($score1) .. "," .. STR($score2) .. "," .. STR($game_state) .. "," .. STR($winner) .. "," .. STR($start_delay)
        NET_SEND_TO($sock, $client_ip, $client_port, $state)
    endif

    # 4. Randare Ecran Host
    GL_CLEAR(0)

    GL_LINE(15, $p1_y - 40, 15, $p1_y + 40, 16777215)
    GL_LINE(16, $p1_y - 40, 16, $p1_y + 40, 16777215)
    GL_LINE(17, $p1_y - 40, 17, $p1_y + 40, 16777215)

    GL_LINE(783, $p2_y - 40, 783, $p2_y + 40, 16777215)
    GL_LINE(784, $p2_y - 40, 784, $p2_y + 40, 16777215)
    GL_LINE(785, $p2_y - 40, 785, $p2_y + 40, 16777215)

    GL_FILL_CIRCLE($ball_x, $ball_y, 10, 16776960)

    GL_TEXT(200, 30, "P1: " .. STR($score1))
    GL_TEXT(340, 30, "VITEZA: " .. STR(INT(ABS($ball_vx))))
    GL_TEXT(550, 30, "P2: " .. STR($score2))

    if $game_state == 0 then
        if $client_connected == 0 then
            GL_TEXT(300, 200, "ASTEPTAM CLIENTUL...")
        else
            if $start_delay > 0 then
                $sec_left = INT($start_delay / 60) + 1
                GL_TEXT(310, 200, "START IN: " .. STR($sec_left) .. " SECUNDE")
            endif
        endif
    endif

    if $game_state == 1 then
        if $winner == 1 then GL_TEXT(310, 250, "VICTORIE HOST (P1)!") endif
        if $winner == 2 then GL_TEXT(300, 250, "VICTORIE CLIENT (P2)!") endif
        
        $restart_sec = INT($restart_timer / 60) + 1
        GL_TEXT(290, 290, "RESTART IN: " .. STR($restart_sec) .. " SEC")
    endif

    $running = GL_PRESENT()
    WAIT(16)
endwhile

SND_CLOSE()
NET_CLOSE($sock)
GL_CLOSE()
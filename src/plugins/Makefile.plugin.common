# Makefile.plugin.common
CXX = g++
CXXFLAGS = -std=c++20 -Wall -Wextra -O3 -fPIC -I../../../include
LDFLAGS = -shared

# Numele pluginului este determinat de numele directorului curent
PLUGIN_NAME = $(notdir $(CURDIR))
TARGET = ../../../$(PLUGIN_NAME).so

SRCS = $(wildcard *.cpp)
OBJS = $(SRCS:.cpp=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f *.o $(TARGET)

.PHONY: all clean